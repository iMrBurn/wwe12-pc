@@ -4507,7 +4513,29 @@ namespace plume {
     // VulkanInterface
 
     VulkanInterface::VulkanInterface() {
+#if defined(__ANDROID__)
+        // WWE '12 Android: a custom Vulkan driver (Mesa Turnip...) chosen by the player, loaded by
+        // the app (port/src/android/wwe12_driver.cpp, weak: absent = the phone's own driver).
+        VkResult res = VK_ERROR_INITIALIZATION_FAILED;
+        void *customDriver = wwe12_custom_vulkan_driver ? wwe12_custom_vulkan_driver() : nullptr;
+        if (customDriver != nullptr) {
+            auto getInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(customDriver, "vkGetInstanceProcAddr"));
+            // Some driver packages only export the loader-interface name (Android #30).
+            if (getInstanceProcAddr == nullptr)
+                getInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(customDriver, "vk_icdGetInstanceProcAddr"));
+            if (getInstanceProcAddr != nullptr) {
+                volkInitializeCustom(getInstanceProcAddr);
+                res = VK_SUCCESS;
+            } else {
+                fprintf(stderr, "custom Vulkan driver: no vkGetInstanceProcAddr in it, using the phone's own driver\n");
+            }
+        }
+        if (res != VK_SUCCESS) {
+            res = volkInitialize();
+        }
+#else
         VkResult res = volkInitialize();
+#endif
         if (res != VK_SUCCESS) {
             fprintf(stderr, "volkInitialize failed with error code 0x%X.\n", res);
             return;
