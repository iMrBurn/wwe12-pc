+#pragma once
+/**
+ * User music for the Xbox music player (XMP): the "music" folder next to the executable stands in
+ * for the console's Music Library, and the player plays its files on the host.
+ *
+ * Games that let the player use their own music ask XMP for the user's playlists (an enumerator,
+ * XamCreateEnumeratorHandle(app 0xFA, 0x70026, 0x70027), opened by XMP message 0x70025): each file
+ * of the folder is one playlist of one song. Each playlist record is kItemSize bytes: its name
+ * (UTF-16, big-endian, NUL-terminated) at byte 572, and at the end a tag of ours (track id +
+ * "W12M"), so that when the game hands the record back to play it (XMP message 0x7003B), possibly
+ * from a save made in an earlier session, the file is found again. Seen with WWE '12 (USER
+ * PLAYLIST in Create an Entrance).
+ *
+ * Files are decoded with Media Foundation (mp3, m4a/aac, wma, wav, flac) and played through an SDL
+ * audio stream, their loudness levelled to the games' own music (xmp_music_normalize).
+ */
+
+#include <cstdint>
+#include <filesystem>
+#include <string>
+#include <vector>
+
+namespace rex::kernel::xam::apps::music {
+
+constexpr uint32_t kItemSize = 820;
+
+struct Track {
+  std::u16string name;  // shown by the game (the file name without its extension)
+  std::filesystem::path path;
+  uint32_t id = 0;  // FNV-1a of the lower-case file name, stable across sessions
+};
+
+std::filesystem::path Folder();
+std::vector<Track> ListTracks();
+
+// Writes the playlist record of `track` (kItemSize bytes, guest layout).
+void WriteItem(const Track& track, uint8_t* item);
+// The track a record written by WriteItem points to; nullptr when the file is gone.
+bool FindTrack(const uint8_t* item, Track* out);
+
+// The host player (one song at a time).
+void Play(const Track& track);
+void Stop();
+void Pause();
+void Resume();
+void SetVolume(float volume);
+bool IsPlaying();  // false once the song has ended or was stopped
+
+}  // namespace rex::kernel::xam::apps::music
