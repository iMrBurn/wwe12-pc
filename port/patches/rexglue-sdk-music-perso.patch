+/**
+ * User music for the Xbox music player (XMP): see xmp_music.h.
+ */
+
+#include "xmp_music.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <mutex>
+#include <thread>
+
+#include <SDL3/SDL_audio.h>
+#include <SDL3/SDL_init.h>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/platform.h>
+#include <rex/string.h>
+#include <rex/string/utf8.h>
+
+#if REX_PLATFORM_WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#include <mfapi.h>
+#include <mferror.h>
+#include <mfidl.h>
+#include <mfreadwrite.h>
+#endif
+
+REXCVAR_DEFINE_STRING(xmp_music_folder, "", "XMP",
+                      "Folder of the user's music (the console's Music Library); empty = the "
+                      "\"music\" folder next to the executable.");
+REXCVAR_DEFINE_BOOL(xmp_music_normalize, true, "XMP",
+                    "Level the loudness of user music to xmp_music_level_db.");
+REXCVAR_DEFINE_INT32(xmp_music_level_db, -20, "XMP",
+                     "Target loudness of user music (RMS, dBFS); commercial songs sit near -9, game "
+                     "music near -20.")
+    .range(-40, -6);
+
+REXCVAR_DEFINE_BOOL(xmp_music_output, true, "XMP",
+                    "Dev: play user music (false = act as if it played, without sound).");
+
+namespace rex::kernel::xam::apps::music {
+
+namespace {
+
+constexpr char kTag[4] = {'W', '1', '2', 'M'};
+constexpr size_t kNameOffset = 572;  // WWE '12 reads the name there (menu and entrance code)
+constexpr size_t kNameChars = 39;     // the game copies 80 bytes of the name
+
+uint32_t Fnv1a32(const std::string& s) {
+  uint32_t h = 0x811C9DC5u;
+  for (unsigned char c : s)
+    h = (h ^ c) * 0x01000193u;
+  return h ? h : 1;
+}
+
+bool IsMusicFile(const std::filesystem::path& p) {
+  std::string ext = rex::string::to_utf8(p.extension().u16string());
+  std::transform(ext.begin(), ext.end(), ext.begin(), [](unsigned char c) { return std::tolower(c); });
+  return ext == ".mp3" || ext == ".m4a" || ext == ".aac" || ext == ".wma" || ext == ".wav" ||
+         ext == ".flac";
+}
+
+void StoreBe32(uint8_t* p, uint32_t v) {
+  p[0] = uint8_t(v >> 24);
+  p[1] = uint8_t(v >> 16);
+  p[2] = uint8_t(v >> 8);
+  p[3] = uint8_t(v);
+}
+
+uint32_t LoadBe32(const uint8_t* p) {
+  return uint32_t(p[0]) << 24 | uint32_t(p[1]) << 16 | uint32_t(p[2]) << 8 | p[3];
+}
+
+// ---- the host player ----
+
+struct PlayerState {
+  std::mutex mutex;
+  std::thread worker;
+  std::atomic<bool> cancel{false};
+  std::atomic<bool> decoding{false};
+  std::atomic<bool> silent{false};  // xmp_music_output = false: "playing" until stopped
+  SDL_AudioStream* stream = nullptr;
+  float volume = 1.0f;
+  bool paused = false;
+  std::u16string playing_path;  // the track currently playing; re-requests of it continue it
+};
+
+PlayerState& State() {
+  static PlayerState state;
+  return state;
+}
+
+#if REX_PLATFORM_WIN32
+// Decodes `path` to interleaved float samples, handing them out in chunks of ~1 s. Returns false
+// when Media Foundation cannot open the file.
+template <typename OnFormat, typename OnChunk>
+bool Decode(const std::filesystem::path& path, const std::atomic<bool>& cancel, OnFormat on_format,
+            OnChunk on_chunk) {
+  static std::once_flag mf_once;
+  std::call_once(mf_once, [] { MFStartup(MF_VERSION, MFSTARTUP_LITE); });
+  IMFSourceReader* reader = nullptr;
+  if (FAILED(MFCreateSourceReaderFromURL(path.wstring().c_str(), nullptr, &reader)))
+    return false;
+  const DWORD stream = DWORD(MF_SOURCE_READER_FIRST_AUDIO_STREAM);
+  reader->SetStreamSelection(DWORD(MF_SOURCE_READER_ALL_STREAMS), FALSE);
+  reader->SetStreamSelection(stream, TRUE);
+  IMFMediaType* want = nullptr;
+  MFCreateMediaType(&want);
+  want->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Audio);
+  want->SetGUID(MF_MT_SUBTYPE, MFAudioFormat_Float);
+  const bool ok = SUCCEEDED(reader->SetCurrentMediaType(stream, nullptr, want));
+  want->Release();
+  IMFMediaType* got = nullptr;
+  UINT32 channels = 0, rate = 0;
+  if (ok && SUCCEEDED(reader->GetCurrentMediaType(stream, &got))) {
+    got->GetUINT32(MF_MT_AUDIO_NUM_CHANNELS, &channels);
+    got->GetUINT32(MF_MT_AUDIO_SAMPLES_PER_SECOND, &rate);
+    got->Release();
+  }
+  if (!ok || !channels || !rate) {
+    reader->Release();
+    return false;
+  }
+  on_format(int(channels), int(rate));
+  std::vector<float> chunk;
+  const size_t chunk_samples = size_t(rate) * channels;
+  while (!cancel) {
+    DWORD flags = 0;
+    IMFSample* sample = nullptr;
+    if (FAILED(reader->ReadSample(stream, 0, nullptr, &flags, nullptr, &sample)))
+      break;
+    if (sample) {
+      IMFMediaBuffer* buffer = nullptr;
+      if (SUCCEEDED(sample->ConvertToContiguousBuffer(&buffer))) {
+        BYTE* data = nullptr;
+        DWORD length = 0;
+        if (SUCCEEDED(buffer->Lock(&data, nullptr, &length))) {
+          const float* f = reinterpret_cast<const float*>(data);
+          chunk.insert(chunk.end(), f, f + length / sizeof(float));
+          buffer->Unlock();
+        }
+        buffer->Release();
+      }
+      sample->Release();
+    }
+    const bool end = flags & MF_SOURCE_READERF_ENDOFSTREAM;
+    if (chunk.size() >= chunk_samples || (end && !chunk.empty())) {
+      on_chunk(chunk);
+      chunk.clear();
+    }
+    if (end)
+      break;
+  }
+  reader->Release();
+  return true;
+}
+#endif
+
+// Gain bringing the RMS of the first seconds of the song to xmp_music_level_db, and its peak
+// under full scale.
+float LevelGain(const std::vector<float>& samples) {
+  if (!REXCVAR_GET(xmp_music_normalize) || samples.empty())
+    return 1.0f;
+  double sum = 0;
+  float peak = 0;
+  for (float s : samples) {
+    sum += double(s) * s;
+    peak = std::max(peak, std::fabs(s));
+  }
+  const double rms = std::sqrt(sum / double(samples.size()));
+  if (rms < 1e-5)
+    return 1.0f;
+  const double rms_db = 20.0 * std::log10(rms);
+  double gain_db = double(REXCVAR_GET(xmp_music_level_db)) - rms_db;
+  gain_db = std::clamp(gain_db, -30.0, 6.0);
+  float gain = float(std::pow(10.0, gain_db / 20.0));
+  if (peak * gain > 0.98f)
+    gain = 0.98f / peak;
+  REXKRNL_INFO("XMP music: level {:.1f} dBFS RMS, gain {:.1f} dB", rms_db,
+               20.0 * std::log10(double(gain)));
+  return gain;
+}
+
+void Worker(Track track) {
+  PlayerState& st = State();
+  SDL_InitSubSystem(SDL_INIT_AUDIO);
+  float gain = 1.0f;
+  bool started = false;
+  std::vector<float> lead;  // the first seconds, held back to measure the level
+  int channels = 2, rate = 48000;
+  constexpr int kLeadSeconds = 15;
+  auto flush = [&](const std::vector<float>& samples) {
+    std::vector<float> scaled(samples);
+    for (float& s : scaled)
+      s = std::clamp(s * gain, -1.0f, 1.0f);
+    std::lock_guard lock(st.mutex);
+    if (st.stream)
+      SDL_PutAudioStreamData(st.stream, scaled.data(), int(scaled.size() * sizeof(float)));
+  };
+  auto start = [&] {
+    gain = LevelGain(lead);
+    SDL_AudioSpec spec{SDL_AUDIO_F32, channels, rate};
+    SDL_AudioStream* stream =
+        SDL_OpenAudioDeviceStream(SDL_AUDIO_DEVICE_DEFAULT_PLAYBACK, &spec, nullptr, nullptr);
+    if (!stream) {
+      REXKRNL_ERROR("XMP music: no audio output: {}", SDL_GetError());
+      return;
+    }
+    {
+      std::lock_guard lock(st.mutex);
+      st.stream = stream;
+      SDL_SetAudioStreamGain(stream, st.volume);
+    }
+    flush(lead);
+    lead.clear();
+    std::lock_guard lock(st.mutex);
+    if (!st.paused)
+      SDL_ResumeAudioStreamDevice(stream);
+    started = true;
+  };
+  bool decoded = false;
+#if REX_PLATFORM_WIN32
+  CoInitializeEx(nullptr, COINIT_MULTITHREADED);
+  decoded = Decode(
+      track.path, st.cancel,
+      [&](int c, int r) {
+        channels = c;
+        rate = r;
+      },
+      [&](const std::vector<float>& chunk) {
+        if (started) {
+          flush(chunk);
+          return;
+        }
+        lead.insert(lead.end(), chunk.begin(), chunk.end());
+        if (lead.size() >= size_t(kLeadSeconds) * rate * channels)
+          start();
+      });
+  CoUninitialize();
+#endif
+  if (!decoded)
+    REXKRNL_ERROR("XMP music: cannot decode {}", rex::string::to_utf8(track.path.u16string()));
+  else if (!started && !st.cancel)
+    start();  // songs shorter than the lead
+  st.decoding = false;
+}
+
+}  // namespace
+
+std::filesystem::path Folder() {
+  const std::string custom = REXCVAR_GET(xmp_music_folder);
+  if (!custom.empty())
+    return std::filesystem::path(rex::string::to_utf16(custom));
+  return rex::filesystem::GetExecutableFolder() / "music";
+}
+
+std::vector<Track> ListTracks() {
+  std::vector<Track> tracks;
+  std::error_code ec;
+  for (const auto& entry : std::filesystem::directory_iterator(Folder(), ec)) {
+    if (!entry.is_regular_file(ec) || !IsMusicFile(entry.path()))
+      continue;
+    Track t;
+    t.path = entry.path();
+    t.name = entry.path().stem().u16string().substr(0, kNameChars);
+    std::string key = rex::string::to_utf8(entry.path().filename().u16string());
+    std::transform(key.begin(), key.end(), key.begin(), [](unsigned char c) { return std::tolower(c); });
+    t.id = Fnv1a32(key);
+    tracks.push_back(std::move(t));
+  }
+  std::sort(tracks.begin(), tracks.end(), [](const Track& a, const Track& b) { return a.name < b.name; });
+  return tracks;
+}
+
+void WriteItem(const Track& track, uint8_t* item) {
+  std::memset(item, 0, kItemSize);
+  for (size_t i = 0; i < track.name.size() && i < kNameChars; ++i) {
+    item[kNameOffset + i * 2] = uint8_t(track.name[i] >> 8);
+    item[kNameOffset + i * 2 + 1] = uint8_t(track.name[i]);
+  }
+  StoreBe32(item + kItemSize - 8, track.id);
+  std::memcpy(item + kItemSize - 4, kTag, 4);
+}
+
+bool FindTrack(const uint8_t* item, Track* out) {
+  std::vector<Track> tracks = ListTracks();
+  if (std::memcmp(item + kItemSize - 4, kTag, 4) == 0) {
+    const uint32_t id = LoadBe32(item + kItemSize - 8);
+    for (const Track& t : tracks)
+      if (t.id == id) {
+        *out = t;
+        return true;
+      }
+  }
+  // A record without our tag, or a renamed file: match by the name the game shows.
+  std::u16string name;
+  const uint8_t* n = item + kNameOffset;
+  for (size_t i = 0; i < kNameChars && (n[i * 2] || n[i * 2 + 1]); ++i)
+    name += char16_t(n[i * 2] << 8 | n[i * 2 + 1]);
+  for (const Track& t : tracks)
+    if (t.name == name) {
+      *out = t;
+      return true;
+    }
+  return false;
+}
+
+void Play(const Track& track) {
+  PlayerState& st = State();
+  const std::u16string path16 = track.path.u16string();
+  {
+    std::lock_guard lock(st.mutex);
+    const std::atomic<bool>& decoding = st.decoding;
+    const bool still_playing = decoding.load() || st.silent ||
+                               (st.stream && SDL_GetAudioStreamQueued(st.stream) > 0);
+    if (st.playing_path == path16 && still_playing) {
+      // The game re-requests the track that is already playing (the victory
+      // scene after the match replay): keep it going instead of restarting.
+      return;
+    }
+  }
+  Stop();
+  REXKRNL_INFO("XMP music: playing {}", rex::string::to_utf8(path16));
+  st.cancel = false;
+  st.paused = false;
+  {
+    std::lock_guard lock(st.mutex);
+    st.playing_path = path16;
+  }
+  if (!REXCVAR_GET(xmp_music_output)) {
+    st.silent = true;
+    return;
+  }
+  st.decoding = true;
+  st.worker = std::thread(Worker, track);
+}
+
+void Stop() {
+  PlayerState& st = State();
+  st.cancel = true;
+  st.silent = false;
+  if (st.worker.joinable())
+    st.worker.join();
+  std::lock_guard lock(st.mutex);
+  st.playing_path.clear();
+  if (st.stream) {
+    SDL_DestroyAudioStream(st.stream);
+    st.stream = nullptr;
+  }
+  st.decoding = false;
+}
+
+void Pause() {
+  PlayerState& st = State();
+  std::lock_guard lock(st.mutex);
+  st.paused = true;
+  if (st.stream)
+    SDL_PauseAudioStreamDevice(st.stream);
+}
+
+void Resume() {
+  PlayerState& st = State();
+  std::lock_guard lock(st.mutex);
+  st.paused = false;
+  if (st.stream)
+    SDL_ResumeAudioStreamDevice(st.stream);
+}
+
+void SetVolume(float volume) {
+  PlayerState& st = State();
+  std::lock_guard lock(st.mutex);
+  st.volume = std::clamp(volume, 0.0f, 1.0f);
+  if (st.stream)
+    SDL_SetAudioStreamGain(st.stream, st.volume);
+}
+
+bool IsPlaying() {
+  PlayerState& st = State();
+  if (st.decoding || st.silent)
+    return true;
+  std::lock_guard lock(st.mutex);
+  return st.stream && SDL_GetAudioStreamQueued(st.stream) > 0;
+}
+
+}  // namespace rex::kernel::xam::apps::music
