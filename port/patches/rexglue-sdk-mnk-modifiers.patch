+// The modifier a bare token names ("Ctrl" is "Control"'s other name), or 0.
+uint8_t ModifierBit(std::string_view token) {
+  if (token == "Shift") {
+    return kModShift;
+  }
+  if (token == "Ctrl" || token == "Control") {
+    return kModCtrl;
+  }
+  if (token == "Alt") {
+    return kModAlt;
+  }
+  return 0;
+}
+
+// The modifiers that one bind's alternatives name on their own.
+uint8_t BareModifiers(std::string_view rest) {
+  uint8_t mods = 0;
+  while (!rest.empty()) {
+    size_t comma = rest.find(',');
+    mods |= ModifierBit(TrimSpaces(rest.substr(0, comma)));
+    if (comma == std::string_view::npos) {
+      break;
+    }
+    rest.remove_prefix(comma + 1);
+  }
+  return mods;
+}
