 namespace {
 constexpr std::chrono::milliseconds kWorkerShutdownTimeout{500};
+
+// audio_flow_log: the game's audio callback (run on the audio worker), for the [apuflow] line.
+std::atomic<int64_t> g_callback_start_ms{0};  // 0 = not running
+std::atomic<uint32_t> g_callback_calls{0};
+std::atomic<int64_t> g_callback_slowest_ms{0};
+
+int64_t NowMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
 }  // namespace
 
+std::string AudioCallbackState() {
+  const int64_t start = g_callback_start_ms.load();
+  const uint32_t calls = g_callback_calls.exchange(0);
+  const int64_t slowest = g_callback_slowest_ms.exchange(0);
+  return start ? fmt::format("game callback RUNNING for {} ms ({} calls, slowest {} ms)",
+                             NowMs() - start, calls, slowest)
+               : fmt::format("game callback idle ({} calls, slowest {} ms)", calls, slowest);
+}
+
 AudioSystem::AudioSystem(runtime::FunctionDispatcher* function_dispatcher)
