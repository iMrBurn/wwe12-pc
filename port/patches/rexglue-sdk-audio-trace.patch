         uint64_t args[] = {client_callback_arg};
+        const int64_t start_ms = NowMs();
+        g_callback_start_ms.store(start_ms);
         function_dispatcher_->Execute(worker_thread_->thread_state(), client_callback, args,
                                       rex::countof(args));
+        g_callback_start_ms.store(0);
+        g_callback_calls.fetch_add(1);
+        const int64_t took = NowMs() - start_ms;
+        if (took > g_callback_slowest_ms.load())
+          g_callback_slowest_ms.store(took);
