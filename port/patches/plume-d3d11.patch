+    // D3D11Texture
+
+    D3D11Texture::D3D11Texture(D3D11Device *device, const RenderTextureDesc &desc) : device(device), desc(desc) {
+        const DXGI_FORMAT format = toDXGI(desc.format);
+        UINT bind = 0;
+        if (desc.flags & RenderTextureFlag::RENDER_TARGET) bind |= D3D11_BIND_RENDER_TARGET;
+        if (desc.flags & RenderTextureFlag::DEPTH_TARGET) bind |= D3D11_BIND_DEPTH_STENCIL;
+        // Every texture is sampled (depth: through a typeless format).
+        const bool depthNoTypeless = format == DXGI_FORMAT_D32_FLOAT || format == DXGI_FORMAT_D16_UNORM;
+        if (!depthNoTypeless) bind |= D3D11_BIND_SHADER_RESOURCE;
+        const UINT mips = std::max(desc.mipLevels, 1u);
+        // D3D12's committed resources start zeroed and the renderer relies on
+        // it (targets read before being written, resolves filling part of a
+        // texture); D3D11 doesn't promise it (WARP leaves garbage): targets and
+        // committed textures get zeros as their initial data.
+        const bool zeroed = desc.committed || (desc.flags & (RenderTextureFlag::RENDER_TARGET | RenderTextureFlag::DEPTH_TARGET));
+        const uint32_t blockWidth = RenderFormatBlockWidth(desc.format);
+        const uint32_t texelBytes = std::max(RenderFormatSize(desc.format), 1u);
+        const UINT layers = desc.dimension == RenderTextureDimension::TEXTURE_3D ? 1 : std::max(desc.arraySize, 1u) * ((desc.flags & RenderTextureFlag::CUBE) && desc.arraySize < 6 ? 6 : 1);
+        std::vector<uint8_t> zeros;
+        std::vector<D3D11_SUBRESOURCE_DATA> initial;
+        if (zeroed) {
+            const UINT rowPitch = ((desc.width + blockWidth - 1) / blockWidth) * texelBytes;
+            const UINT slicePitch = rowPitch * ((std::max(desc.height, 1u) + blockWidth - 1) / blockWidth);
+            zeros.assign(size_t(slicePitch) * std::max(desc.depth, 1u), 0);
+            for (UINT layer = 0; layer < layers; ++layer) {
+                for (UINT mip = 0; mip < mips; ++mip) {
+                    const UINT w = std::max(desc.width >> mip, 1u), h = std::max(std::max(desc.height, 1u) >> mip, 1u);
+                    const UINT row = ((w + blockWidth - 1) / blockWidth) * texelBytes;
+                    initial.push_back({zeros.data(), row, row * ((h + blockWidth - 1) / blockWidth)});
+                }
+            }
+        }
+        if (desc.dimension == RenderTextureDimension::TEXTURE_3D) {
+            D3D11_TEXTURE3D_DESC d = {};
+            d.Width = desc.width;
+            d.Height = desc.height;
+            d.Depth = std::max(desc.depth, 1u);
+            d.MipLevels = mips;
+            d.Format = format;
+            d.Usage = D3D11_USAGE_DEFAULT;
+            d.BindFlags = bind;
+            Microsoft::WRL::ComPtr<ID3D11Texture3D> t;
+            if (SUCCEEDED(device->d3d->CreateTexture3D(&d, zeroed ? initial.data() : nullptr, &t))) d3d = t;
+            return;
+        }
+        D3D11_TEXTURE2D_DESC d = {};
+        d.Width = desc.width;
+        d.Height = std::max(desc.height, 1u);
+        d.MipLevels = mips;
+        const bool cube = (desc.flags & RenderTextureFlag::CUBE) != 0;
+        d.ArraySize = std::max(desc.arraySize, 1u);
+        if (cube && d.ArraySize < 6) d.ArraySize = 6;
+        d.Format = format;
+        d.SampleDesc.Count = 1;
+        d.Usage = D3D11_USAGE_DEFAULT;
+        d.BindFlags = bind;
+        d.MiscFlags = cube ? D3D11_RESOURCE_MISC_TEXTURECUBE : 0;
+        Microsoft::WRL::ComPtr<ID3D11Texture2D> t;
+        if (SUCCEEDED(device->d3d->CreateTexture2D(&d, zeroed ? initial.data() : nullptr, &t))) d3d = t;
+    }
+
+    std::unique_ptr<RenderTextureView> D3D11Texture::createTextureView(const RenderTextureViewDesc &desc) const {
+        return std::make_unique<D3D11TextureView>(this, desc);
+    }
+
+    void D3D11Texture::setName(const std::string &name) {
+        if (d3d) d3d->SetPrivateData(WKPDID_D3DDebugObjectName, UINT(name.size()), name.data());
+    }
+
+    ID3D11ShaderResourceView *D3D11Texture::getDefaultSrv() const {
+        std::lock_guard lock(viewMutex);
+        if (!defaultSrv && d3d) {
+            RenderTextureViewDesc v;
+            v.format = desc.format;
+            v.dimension = desc.dimension == RenderTextureDimension::TEXTURE_3D ? RenderTextureViewDimension::TEXTURE_3D
+                          : (desc.flags & RenderTextureFlag::CUBE)        ? RenderTextureViewDimension::TEXTURE_CUBE
+                                                                          : RenderTextureViewDimension::TEXTURE_2D;
+            D3D11TextureView view(this, v);
+            defaultSrv = view.srv;
+        }
+        return defaultSrv.Get();
+    }
+
+    // D3D11TextureView
+
+    D3D11TextureView::D3D11TextureView(const D3D11Texture *texture, const RenderTextureViewDesc &desc) : texture(texture), desc(desc) {
+        if (!texture->d3d) return;
+        D3D11_SHADER_RESOURCE_VIEW_DESC d = {};
+        d.Format = toDXGITextureView(desc.format != RenderFormat::UNKNOWN ? desc.format : texture->desc.format);
+        const UINT mips = desc.mipLevels == UINT32_MAX ? UINT(-1) : desc.mipLevels;
+        switch (desc.dimension) {
+        case RenderTextureViewDimension::TEXTURE_3D:
+            d.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE3D;
+            d.Texture3D.MostDetailedMip = desc.mipSlice;
+            d.Texture3D.MipLevels = mips;
+            break;
+        case RenderTextureViewDimension::TEXTURE_CUBE:
+            d.ViewDimension = D3D11_SRV_DIMENSION_TEXTURECUBE;
+            d.TextureCube.MostDetailedMip = desc.mipSlice;
+            d.TextureCube.MipLevels = mips;
+            break;
+        default:
+            if (texture->desc.arraySize > 1 || (texture->desc.flags & RenderTextureFlag::CUBE)) {
+                d.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2DARRAY;
+                d.Texture2DArray.MostDetailedMip = desc.mipSlice;
+                d.Texture2DArray.MipLevels = mips;
+                d.Texture2DArray.FirstArraySlice = desc.arrayIndex;
+                d.Texture2DArray.ArraySize = desc.arraySize == UINT32_MAX ? 1 : desc.arraySize;
+            } else {
+                d.ViewDimension = D3D11_SRV_DIMENSION_TEXTURE2D;
+                d.Texture2D.MostDetailedMip = desc.mipSlice;
+                d.Texture2D.MipLevels = mips;
+            }
+            break;
+        }
+        texture->device->d3d->CreateShaderResourceView(texture->d3d.Get(), &d, &srv);
+    }
+
+    // D3D11Shader
+
+    D3D11Shader::D3D11Shader(D3D11Device *device, const void *data, uint64_t size) : device(device) {
+        const auto *bytes = static_cast<const uint8_t *>(data);
+        code.assign(bytes, bytes + size);
+        // The program type: the SHDR / SHEX chunk's version token (1: vertex).
+        if (code.size() >= 32 && std::memcmp(code.data(), "DXBC", 4) == 0) {
+            uint32_t chunkCount;
+            std::memcpy(&chunkCount, code.data() + 28, 4);
+            for (uint32_t c = 0; c < chunkCount && 32 + 4 * (c + 1) <= code.size(); ++c) {
+                uint32_t chunkOffset;
+                std::memcpy(&chunkOffset, code.data() + 32 + 4 * c, 4);
+                if (chunkOffset + 12 > code.size()) continue;
+                if (std::memcmp(code.data() + chunkOffset, "SHDR", 4) == 0 || std::memcmp(code.data() + chunkOffset, "SHEX", 4) == 0) {
+                    uint32_t version;
+                    std::memcpy(&version, code.data() + chunkOffset + 8, 4);
+                    isVertex = ((version >> 16) & 0xFFFF) == 1;
+                    break;
+                }
+            }
+        }
+        if (isVertex) {
+            device->d3d->CreateVertexShader(code.data(), code.size(), nullptr, &vs);
+        } else {
+            device->d3d->CreatePixelShader(code.data(), code.size(), nullptr, &ps);
+        }
+    }
+
+    // D3D11DescriptorSet
+
+    D3D11DescriptorSet::D3D11DescriptorSet(const RenderDescriptorSetDesc &desc) {
+        for (uint32_t i = 0; i < desc.descriptorRangesCount; ++i) {
+            const RenderDescriptorRange &range = desc.descriptorRanges[i];
+            Kind kind = Kind::NONE;
+            switch (range.type) {
+            case RenderDescriptorRangeType::TEXTURE:
+            case RenderDescriptorRangeType::FORMATTED_BUFFER:
+            case RenderDescriptorRangeType::STRUCTURED_BUFFER:
+            case RenderDescriptorRangeType::BYTE_ADDRESS_BUFFER:
+                kind = Kind::SRV;
+                break;
+            case RenderDescriptorRangeType::SAMPLER:
+                kind = Kind::SAMPLER;
+                break;
+            case RenderDescriptorRangeType::CONSTANT_BUFFER:
+                kind = Kind::CBV;
+                break;
+            default:
+                Unsupported("descriptor range type");
+                break;
+            }
+            const uint32_t count = (desc.lastRangeIsBoundless && i + 1 == desc.descriptorRangesCount) ? std::max(desc.boundlessRangeSize, range.count) : range.count;
+            for (uint32_t k = 0; k < count; ++k) {
+                Entry e;
+                e.kind = kind;
+                e.reg = uint8_t(std::min<uint32_t>(range.binding + k, 255));
+                entries.push_back(e);
+            }
+        }
+        bindless = entries.size() > 64;
+        srvs.resize(entries.size(), nullptr);
+        samplers.resize(entries.size(), nullptr);
+        mappings.resize(entries.size());
+        buffers.resize(entries.size(), nullptr);
+    }
+
+    D3D11DescriptorSet::~D3D11DescriptorSet() {
+        for (ID3D11ShaderResourceView *v : srvs) if (v) v->Release();
+        for (ID3D11SamplerState *s : samplers) if (s) s->Release();
+    }
+
+    void D3D11DescriptorSet::setBuffer(uint32_t descriptorIndex, const RenderBuffer *buffer, uint64_t bufferSize, const RenderBufferStructuredView *bufferStructuredView, const RenderBufferFormattedView *bufferFormattedView) {
+        if (descriptorIndex >= entries.size()) return;
+        buffers[descriptorIndex] = static_cast<const D3D11Buffer *>(buffer);
+        ++version;
+    }
+
+    void D3D11DescriptorSet::setTexture(uint32_t descriptorIndex, const RenderTexture *texture, RenderTextureLayout textureLayout, const RenderTextureView *textureView) {
+        if (descriptorIndex >= entries.size()) return;
+        ID3D11ShaderResourceView *srv = nullptr;
+        RenderComponentMapping mapping;
+        if (textureView) {
+            const auto *view = static_cast<const D3D11TextureView *>(textureView);
+            srv = view->srv.Get();
+            mapping = view->desc.componentMapping;
+        } else if (texture) {
+            srv = static_cast<const D3D11Texture *>(texture)->getDefaultSrv();
+        }
+        if (srv) srv->AddRef();
+        if (srvs[descriptorIndex]) srvs[descriptorIndex]->Release();
+        srvs[descriptorIndex] = srv;
+        mappings[descriptorIndex] = mapping;
+        ++version;
+    }
+
+    void D3D11DescriptorSet::setSampler(uint32_t descriptorIndex, const RenderSampler *sampler) {
+        if (descriptorIndex >= entries.size()) return;
+        ID3D11SamplerState *state = sampler ? static_cast<const D3D11Sampler *>(sampler)->d3d.Get() : nullptr;
+        if (state) state->AddRef();
+        if (samplers[descriptorIndex]) samplers[descriptorIndex]->Release();
+        samplers[descriptorIndex] = state;
+        ++version;
+    }
+
+    // D3D11CommandList: commands recorded on the CPU, replayed at submission.
+
+    struct D3D11CommandList : RenderCommandList {
+        enum class Op : uint8_t {
+            SET_FRAMEBUFFER,
+            SET_PIPELINE,
+            SET_LAYOUT,
+            SET_DESCRIPTOR_SET,
+            SET_ROOT_DESCRIPTOR,
+            SET_INDEX_BUFFER,
+            SET_VERTEX_BUFFERS,
+            SET_VIEWPORT,
+            SET_SCISSOR,
+            SET_STENCIL_REFERENCE,
+            SET_BLEND_FACTOR,
+            CLEAR_COLOR,
+            CLEAR_DEPTH_STENCIL,
+            DRAW,
+            DRAW_INDEXED,
+            COPY_TEXTURE_REGION,
+            UPLOAD_TEXTURE_REGION,
+            READBACK_TEXTURE_REGION,
+            COPY_TEXTURE,
+            // WWE '12
+            SET_PUSH_CONSTANTS,  // a = range, b = size, offset = in pushData
+            SET_SLOT_TEXTURE,    // a = register, b = index in the set p0
+            SET_SLOT_SAMPLER,
+        };
+
+        struct Cmd {
+            Op op;
+            uint32_t a = 0, b = 0, c = 0, d = 0, e = 0;
+            const void *p0 = nullptr;
+            const void *p1 = nullptr;
+            uint64_t offset = 0;
+            float f[6] = {};
+            RenderBox box;
+            bool hasBox = false;
+        };
+
+        D3D11Device *device = nullptr;
+        std::vector<Cmd> cmds;
+        // WWE '12: the push constants' bytes (Cmd::offset into it).
+        std::vector<uint8_t> pushData;
+        uint32_t drawCount = 0;
+        uint64_t generation = 0;  // (new at each begin(): device-wide unique)
+        // Upload buffers the list reads, and how far (geometry, constants).
+        std::unordered_map<D3D11Buffer *, std::pair<uint64_t, uint64_t>> uploads;
+        // (the last one noted: most calls repeat it)
+        const D3D11Buffer *lastUpload = nullptr;
+        bool lastUploadConstants = false;
+        uint64_t lastUploadEnd = 0;
+
+        explicit D3D11CommandList(D3D11Device *device) : device(device) { cmds.reserve(4096); }
+
+        void noteUpload(const RenderBuffer *buffer, uint64_t end, bool constants) {
+            auto *b = const_cast<D3D11Buffer *>(static_cast<const D3D11Buffer *>(buffer));
+            if (!b || !b->cpu || b->desc.heapType != RenderHeapType::UPLOAD) return;
+            // (written once and already on the GPU: nothing to upload)
+            if (!b->mapped && (constants ? b->constantsReady && !b->constantsDirty : b->geometryReady && !b->geometryDirty)) return;
+            if (b == lastUpload && constants == lastUploadConstants && end <= lastUploadEnd) return;
+            lastUpload = b;
+            lastUploadConstants = constants;
+            lastUploadEnd = end;
+            auto &range = uploads[b];
+            uint64_t &e = constants ? range.second : range.first;
+            e = std::max(e, end);
+        }
+
+        void begin() override {
+            static std::atomic<uint64_t> generations = 0;
+            generation = ++generations;
+            drawCount = 0;
+            cmds.clear();
+            pushData.clear();
+            uploads.clear();
+            lastUpload = nullptr;
+        }
+        void end() override {}
+        void barriers(RenderBarrierStages, const RenderBufferBarrier *, uint32_t, const RenderTextureBarrier *, uint32_t) override {}
+        void dispatch(uint32_t, uint32_t, uint32_t) override { Unsupported("dispatch"); }
+        void traceRays(uint32_t, uint32_t, uint32_t, RenderBufferReference, const RenderShaderBindingGroupsInfo &) override { Unsupported("traceRays"); }
+
+        void drawInstanced(uint32_t vertexCountPerInstance, uint32_t instanceCount, uint32_t startVertexLocation, uint32_t startInstanceLocation) override {
+            ++drawCount;
+            Cmd c{Op::DRAW};
+            c.a = vertexCountPerInstance;
+            c.b = instanceCount;
+            c.c = startVertexLocation;
+            c.d = startInstanceLocation;
+            cmds.push_back(c);
+        }
+
+        void drawIndexedInstanced(uint32_t indexCountPerInstance, uint32_t instanceCount, uint32_t startIndexLocation, int32_t baseVertexLocation, uint32_t startInstanceLocation) override {
+            ++drawCount;
+            Cmd c{Op::DRAW_INDEXED};
+            c.a = indexCountPerInstance;
+            c.b = instanceCount;
+            c.c = startIndexLocation;
+            c.d = uint32_t(baseVertexLocation);
+            c.e = startInstanceLocation;
+            cmds.push_back(c);
+        }
+
+        void setPipeline(const RenderPipeline *pipeline) override {
+            Cmd c{Op::SET_PIPELINE};
+            c.p0 = pipeline;
+            cmds.push_back(c);
+        }
+
+        void setComputePipelineLayout(const RenderPipelineLayout *) override { Unsupported("compute"); }
+        void setComputePushConstants(uint32_t, const void *, uint32_t, uint32_t) override { Unsupported("compute"); }
+        void setComputeDescriptorSet(RenderDescriptorSet *, uint32_t) override { Unsupported("compute"); }
+
+        void setGraphicsPipelineLayout(const RenderPipelineLayout *pipelineLayout) override {
+            Cmd c{Op::SET_LAYOUT};
+            c.p0 = pipelineLayout;
+            cmds.push_back(c);
+        }
+
+        // WWE '12: the range's bytes go to a constant buffer of its own at replay; `offset` and
+        // `size` update part of it, the rest keeps the last values.
+        void setGraphicsPushConstants(uint32_t rangeIndex, const void *data, uint32_t offset, uint32_t size) override {
+            if (!data || !size) return;
+            Cmd c{Op::SET_PUSH_CONSTANTS};
+            c.a = rangeIndex;
+            c.b = size;
+            c.c = offset;
+            c.offset = pushData.size();
+            pushData.insert(pushData.end(), static_cast<const uint8_t *>(data), static_cast<const uint8_t *>(data) + size);
+            cmds.push_back(c);
+        }
+
+        void setSlot(Op op, uint32_t reg, const RenderDescriptorSet *set, uint32_t index) {
+            Cmd c{op};
+            c.a = reg;
+            c.b = index;
+            c.p0 = set;
+            cmds.push_back(c);
+        }
+
+        void setGraphicsDescriptorSet(RenderDescriptorSet *descriptorSet, uint32_t setIndex) override {
+            Cmd c{Op::SET_DESCRIPTOR_SET};
+            c.p0 = descriptorSet;
+            c.a = setIndex;
+            cmds.push_back(c);
+        }
+
+        void setGraphicsRootDescriptor(RenderBufferReference bufferReference, uint32_t rootDescriptorIndex) override {
+            Cmd c{Op::SET_ROOT_DESCRIPTOR};
+            c.p0 = bufferReference.ref;
+            c.offset = bufferReference.offset;
+            c.a = rootDescriptorIndex;
+            cmds.push_back(c);
+            // (a constant buffer window: up to 4096 constants)
+            if (bufferReference.ref) noteUpload(bufferReference.ref, bufferReference.offset + 65536, true);
+        }
+
+        void setRaytracingPipelineLayout(const RenderPipelineLayout *) override { Unsupported("ray tracing"); }
+        void setRaytracingPushConstants(uint32_t, const void *, uint32_t, uint32_t) override { Unsupported("ray tracing"); }
+        void setRaytracingDescriptorSet(RenderDescriptorSet *, uint32_t) override { Unsupported("ray tracing"); }
+
+        void setIndexBuffer(const RenderIndexBufferView *view) override {
+            Cmd c{Op::SET_INDEX_BUFFER};
+            if (view) {
+                c.p0 = view->buffer.ref;
+                c.offset = view->buffer.offset;
+                c.a = uint32_t(toDXGI(view->format));
+                noteUpload(view->buffer.ref, view->buffer.offset + view->size, false);
+            }
+            cmds.push_back(c);
+        }
+
+        void setVertexBuffers(uint32_t startSlot, const RenderVertexBufferView *views, uint32_t viewCount, const RenderInputSlot *inputSlots) override {
+            for (uint32_t i = 0; i < viewCount; ++i) {
+                Cmd c{Op::SET_VERTEX_BUFFERS};
+                c.a = startSlot + i;
+                c.p0 = views[i].buffer.ref;
+                c.offset = views[i].buffer.offset;
+                c.b = inputSlots ? inputSlots[i].stride : 0;
+                cmds.push_back(c);
+                noteUpload(views[i].buffer.ref, views[i].buffer.offset + views[i].size, false);
+            }
+        }
+
+        void setViewports(const RenderViewport *viewports, uint32_t count) override {
+            if (!count) return;
+            Cmd c{Op::SET_VIEWPORT};
+            c.f[0] = viewports[0].x;
+            c.f[1] = viewports[0].y;
+            c.f[2] = viewports[0].width;
+            c.f[3] = viewports[0].height;
+            c.f[4] = viewports[0].minDepth;
+            c.f[5] = viewports[0].maxDepth;
+            cmds.push_back(c);
+        }
+
+        void setScissors(const RenderRect *scissorRects, uint32_t count) override {
+            if (!count) return;
+            Cmd c{Op::SET_SCISSOR};
+            c.box = RenderBox(scissorRects[0].left, scissorRects[0].top, scissorRects[0].right, scissorRects[0].bottom);
+            cmds.push_back(c);
+        }
+
+        void setFramebuffer(const RenderFramebuffer *framebuffer) override {
+            Cmd c{Op::SET_FRAMEBUFFER};
+            c.p0 = framebuffer;
+            cmds.push_back(c);
+        }
+
+        void setDepthBias(float, float, float) override {}  // (static in the pipeline)
+
+        void setStencilReference(uint32_t stencilReference) {
+            Cmd c{Op::SET_STENCIL_REFERENCE};
+            c.a = stencilReference;
+            cmds.push_back(c);
+        }
+
+        void setBlendFactor(const float blendFactor[4]) {
+            Cmd c{Op::SET_BLEND_FACTOR};
+            std::memcpy(c.f, blendFactor, 4 * sizeof(float));
+            cmds.push_back(c);
+        }
+
+        void clearColor(uint32_t attachmentIndex, RenderColor colorValue, const RenderRect *clearRects, uint32_t clearRectsCount) override {
+            if (clearRectsCount) Unsupported("clear rectangles (the whole target is cleared)");
+            Cmd c{Op::CLEAR_COLOR};
+            c.a = attachmentIndex;
+            std::memcpy(c.f, colorValue.rgba, 4 * sizeof(float));
+            cmds.push_back(c);
+        }
+
+        void clearDepthStencil(bool clearDepth, bool clearStencil, float depthValue, uint32_t stencilValue, const RenderRect *clearRects, uint32_t clearRectsCount) override {
+            if (clearRectsCount) Unsupported("clear rectangles (the whole target is cleared)");
+            Cmd c{Op::CLEAR_DEPTH_STENCIL};
+            c.a = (clearDepth ? D3D11_CLEAR_DEPTH : 0) | (clearStencil ? D3D11_CLEAR_STENCIL : 0);
+            c.b = stencilValue;
+            c.f[0] = depthValue;
+            cmds.push_back(c);
+        }
+
+        void copyBufferRegion(RenderBufferReference, RenderBufferReference, uint64_t) override { Unsupported("copyBufferRegion"); }
+
+        void copyTextureRegion(const RenderTextureCopyLocation &dstLocation, const RenderTextureCopyLocation &srcLocation, uint32_t dstX, uint32_t dstY, uint32_t dstZ, const RenderBox *srcBox) override {
+            Cmd c{Op::COPY_TEXTURE_REGION};
+            c.c = dstX;
+            c.d = dstY;
+            c.e = dstZ;
+            if (srcBox) {
+                c.box = *srcBox;
+                c.hasBox = true;
+            }
+            if (dstLocation.type == RenderTextureCopyType::SUBRESOURCE && srcLocation.type == RenderTextureCopyType::PLACED_FOOTPRINT) {
+                // Upload: buffer -> texture.
+                const auto *dst = static_cast<const D3D11Texture *>(dstLocation.texture);
+                uint32_t rowPitch, rows;
+                FootprintLayout(srcLocation, rowPitch, rows);
+                c.op = Op::UPLOAD_TEXTURE_REGION;
+                c.p0 = dst;
+                c.p1 = srcLocation.buffer;
+                c.offset = srcLocation.placedFootprint.offset;
+                c.a = SubresourceOf(dst, dstLocation.subresource.mipLevel, dstLocation.subresource.arrayIndex);
+                c.b = rowPitch;
+                // The destination box: the footprint's size (blocks rounded up).
+                const uint32_t blockWidth = RenderFormatBlockWidth(srcLocation.placedFootprint.format);
+                c.box = RenderBox(int32_t(dstX), int32_t(dstY),
+                                  int32_t(dstX + ((srcLocation.placedFootprint.width + blockWidth - 1) / blockWidth) * blockWidth),
+                                  int32_t(dstY + rows * blockWidth), int32_t(dstZ), int32_t(dstZ + std::max(srcLocation.placedFootprint.depth, 1u)));
+                c.f[0] = float(rows);  // (rows for the depth pitch)
+                c.hasBox = true;
+            } else if (dstLocation.type == RenderTextureCopyType::PLACED_FOOTPRINT && srcLocation.type == RenderTextureCopyType::SUBRESOURCE) {
+                // Readback: texture -> buffer.
+                const auto *src = static_cast<const D3D11Texture *>(srcLocation.texture);
+                uint32_t rowPitch, rows;
+                FootprintLayout(dstLocation, rowPitch, rows);
+                c.op = Op::READBACK_TEXTURE_REGION;
+                c.p0 = dstLocation.buffer;
+                c.p1 = src;
+                c.offset = dstLocation.placedFootprint.offset;
+                c.a = SubresourceOf(src, srcLocation.subresource.mipLevel, srcLocation.subresource.arrayIndex);
+                c.b = rowPitch;
+                c.c = rows;
+                c.d = std::max(dstLocation.placedFootprint.depth, 1u);
+            } else if (dstLocation.type == RenderTextureCopyType::SUBRESOURCE && srcLocation.type == RenderTextureCopyType::SUBRESOURCE) {
+                const auto *dst = static_cast<const D3D11Texture *>(dstLocation.texture);
+                const auto *src = static_cast<const D3D11Texture *>(srcLocation.texture);
+                c.p0 = dst;
+                c.p1 = src;
+                c.a = SubresourceOf(dst, dstLocation.subresource.mipLevel, dstLocation.subresource.arrayIndex);
+                c.b = SubresourceOf(src, srcLocation.subresource.mipLevel, srcLocation.subresource.arrayIndex);
+            } else {
+                Unsupported("buffer to buffer texture copies");
+                return;
+            }
+            cmds.push_back(c);
+        }
+
+        void copyBuffer(const RenderBuffer *, const RenderBuffer *) override { Unsupported("copyBuffer"); }
+
+        void copyTexture(const RenderTexture *dstTexture, const RenderTexture *srcTexture) override {
+            Cmd c{Op::COPY_TEXTURE};
+            c.p0 = dstTexture;
+            c.p1 = srcTexture;
+            cmds.push_back(c);
+        }
+
+        void resolveTexture(const RenderTexture *, const RenderTexture *) override { Unsupported("resolveTexture"); }
+        void resolveTextureRegion(const RenderTexture *, uint32_t, uint32_t, const RenderTexture *, const RenderRect *, RenderResolveMode) override { Unsupported("resolveTextureRegion"); }
+        void buildBottomLevelAS(const RenderAccelerationStructure *, RenderBufferReference, const RenderBottomLevelASBuildInfo &) override { Unsupported("ray tracing"); }
+        void buildTopLevelAS(const RenderAccelerationStructure *, RenderBufferReference, RenderBufferReference, const RenderTopLevelASBuildInfo &) override { Unsupported("ray tracing"); }
+        void discardTexture(const RenderTexture *) override {}
+        void resetQueryPool(const RenderQueryPool *, uint32_t, uint32_t) override { Unsupported("query pools"); }
+        void writeTimestamp(const RenderQueryPool *, uint32_t) override { Unsupported("query pools"); }
+
+        // Replays the commands on the immediate context (lock held).
+        void replay() const;
+    };
+
+    namespace {
+        // The replay's view of the pipeline's bindings and what is bound, so
+        // only changed registers are set.
+        struct ReplayState {
+            ID3D11DeviceContext *context = nullptr;
+            ID3D11DeviceContext1 *context1 = nullptr;
+            bool offsetting = false;
+            const D3D11GraphicsPipeline *pipeline = nullptr;
+            ShaderBindings vsBindings, psBindings;
+            const D3D11PipelineLayout *layout = nullptr;
+            const D3D11Framebuffer *framebuffer = nullptr;
+            // Wanted (from the sets) and bound, per stage (0 VS, 1 PS).
+            ID3D11ShaderResourceView *srvWanted[64] = {};
+            ID3D11ShaderResourceView *srvBound[2][64] = {};
+            ID3D11SamplerState *samplerWanted[16] = {};
+            ID3D11SamplerState *samplerBound[2][16] = {};
+            bool texturesDirty = true;
+            // Root constant buffers by register: (buffer, offset).
+            const D3D11Buffer *cbBuffer[14] = {};
+            uint64_t cbOffset[14] = {};
+            uint32_t cbDirty = 0;
+            // Copies for constants without offsets (D3D11.0): one per register.
+            Microsoft::WRL::ComPtr<ID3D11Buffer> cbCopies[14];
+            uint32_t stencilReference = 0;
+            float blendFactor[4] = {1.0f, 1.0f, 1.0f, 1.0f};
+            bool outputMergerDirty = true;
+            // WWE '12: push constant ranges, by register (64 bytes each at most here).
+            Microsoft::WRL::ComPtr<ID3D11Buffer> pushBuffers[14];
+            uint8_t pushBytes[14][256] = {};
+            uint32_t draws = 0;
+        };
+
+        void BindSet(ReplayState &s, const D3D11DescriptorSet *set) {
+            if (!set || set->bindless) return;
+            for (size_t i = 0; i < set->entries.size(); ++i) {
+                const D3D11DescriptorSet::Entry &e = set->entries[i];
+                switch (e.kind) {
+                case D3D11DescriptorSet::Kind::SRV:
+                    if (e.reg < 64) s.srvWanted[e.reg] = set->srvs[i];
+                    break;
+                case D3D11DescriptorSet::Kind::SAMPLER:
+                    if (e.reg < 16) s.samplerWanted[e.reg] = set->samplers[i];
+                    break;
+                default:
+                    break;
+                }
+            }
+            s.texturesDirty = true;
+        }
+
+        void FlushTextures(ReplayState &s) {
+            if (!s.texturesDirty) return;
+            s.texturesDirty = false;
+            for (int stage = 0; stage < 2; ++stage) {
+                const ShaderBindings &b = stage ? s.psBindings : s.vsBindings;
+                int first = -1, last = -1;
+                for (int r = 0; r < 64; ++r) {
+                    if (!(b.textures & (1ull << r)) || s.srvBound[stage][r] == s.srvWanted[r]) continue;
+                    if (first < 0) first = r;
+                    last = r;
+                    s.srvBound[stage][r] = s.srvWanted[r];
+                }
+                if (first >= 0) {
+                    // (registers in between the shader doesn't use get what's wanted too)
+                    for (int r = first; r <= last; ++r) s.srvBound[stage][r] = s.srvWanted[r];
+                    if (stage) s.context->PSSetShaderResources(UINT(first), UINT(last - first + 1), &s.srvWanted[first]);
+                    else s.context->VSSetShaderResources(UINT(first), UINT(last - first + 1), &s.srvWanted[first]);
+                }
+                first = last = -1;
+                for (int r = 0; r < 16; ++r) {
+                    if (!(b.samplers & (1u << r)) || s.samplerBound[stage][r] == s.samplerWanted[r]) continue;
+                    if (first < 0) first = r;
+                    last = r;
+                }
+                if (first >= 0) {
+                    for (int r = first; r <= last; ++r) s.samplerBound[stage][r] = s.samplerWanted[r];
+                    if (stage) s.context->PSSetSamplers(UINT(first), UINT(last - first + 1), &s.samplerWanted[first]);
+                    else s.context->VSSetSamplers(UINT(first), UINT(last - first + 1), &s.samplerWanted[first]);
+                }
+            }
+        }
+
+        void FlushConstants(ReplayState &s, ID3D11Device *device) {
+            if (!s.cbDirty) return;
+            const uint32_t used = s.vsBindings.constantBuffers | s.psBindings.constantBuffers;
+            for (uint32_t r = 0; r < 14; ++r) {
+                if (!(s.cbDirty & used & (1u << r))) continue;
+                const D3D11Buffer *buffer = s.cbBuffer[r];
+                if (!buffer) continue;
+                ID3D11Buffer *bind = nullptr;
+                UINT first = 0, count = 4096;
+                if (buffer->d3d) {
+                    bind = buffer->d3d.Get();
+                } else if (s.offsetting && (buffer->combined ? buffer->gpuGeometry : buffer->gpuConstants)) {
+                    bind = buffer->combined ? buffer->gpuGeometry.Get() : buffer->gpuConstants.Get();
+                    first = UINT(s.cbOffset[r] / 16);
+                    const uint64_t remaining = (buffer->desc.size - std::min<uint64_t>(s.cbOffset[r], buffer->desc.size)) / 16;
+                    count = UINT(std::min<uint64_t>(4096, remaining & ~15ull));
+                    if (!count) continue;
+                } else if (buffer->cpu) {
+                    // A copy of the window (4 KB: the game's constants are 256 float4 at most).
+                    if (!s.cbCopies[r]) {
+                        D3D11_BUFFER_DESC d = {};
+                        d.ByteWidth = 4096;
+                        d.Usage = D3D11_USAGE_DYNAMIC;
+                        d.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+                        d.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+                        device->CreateBuffer(&d, nullptr, &s.cbCopies[r]);
+                    }
+                    D3D11_MAPPED_SUBRESOURCE m;
+                    if (!s.cbCopies[r] || FAILED(s.context->Map(s.cbCopies[r].Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &m))) continue;
+                    const uint64_t n = std::min<uint64_t>(4096, buffer->desc.size - std::min<uint64_t>(s.cbOffset[r], buffer->desc.size));
+                    std::memcpy(m.pData, buffer->cpu + s.cbOffset[r], size_t(n));
+                    s.context->Unmap(s.cbCopies[r].Get(), 0);
+                    bind = s.cbCopies[r].Get();
+                    count = 256;
+                }
+                if (!bind) continue;
+                const bool window = s.offsetting && !buffer->d3d;
+                if (s.vsBindings.constantBuffers & (1u << r)) {
+                    if (window) s.context1->VSSetConstantBuffers1(r, 1, &bind, &first, &count);
+                    else s.context->VSSetConstantBuffers(r, 1, &bind);
+                }
+                if (s.psBindings.constantBuffers & (1u << r)) {
+                    if (window) s.context1->PSSetConstantBuffers1(r, 1, &bind, &first, &count);
+                    else s.context->PSSetConstantBuffers(r, 1, &bind);
+                }
+                s.cbDirty &= ~(1u << r);
+            }
+        }
+
+        void FlushOutputMerger(ReplayState &s) {
+            if (!s.outputMergerDirty || !s.pipeline) return;
+            s.outputMergerDirty = false;
+            s.context->OMSetBlendState(s.pipeline->blend.Get(), s.blendFactor, 0xFFFFFFFF);
+            s.context->OMSetDepthStencilState(s.pipeline->depthStencil.Get(), s.pipeline->dynamicStencilReference ? s.stencilReference : s.pipeline->stencilReference);
+        }
+    }
+
+    void D3D11CommandList::replay() const {
+        ReplayState s;
+        s.context = device->context;
+        s.context1 = device->context1.Get();
+        s.offsetting = device->constantBufferOffsetting && s.context1;
+        ID3D11DeviceContext *ctx = s.context;
+        ctx->ClearState();
+
+        // The upload buffers' bytes for this list's draws.
+        const auto t0 = std::chrono::steady_clock::now();
+        for (const auto &[buffer, range] : uploads) {
+            // (without offsets, constants are copied per draw from the CPU bytes)
+            const uint64_t constants = s.offsetting ? range.second : 0;
+            if (range.first || (constants && buffer->mapped && !buffer->gpuConstants)) {
+                // (a ring's first upload makes the combined buffer if it can)
+                buffer->gpu(false, std::max(range.first, constants), generation);
+            }
+            if (constants && !buffer->combined) buffer->gpu(true, constants, generation);
+        }
+
+        const auto t1 = std::chrono::steady_clock::now();
+        const D3D11PipelineLayout *layout = nullptr;
+        for (const Cmd &c : cmds) {
+            switch (c.op) {
+            case Op::SET_FRAMEBUFFER: {
+                const auto *fb = static_cast<const D3D11Framebuffer *>(c.p0);
+                s.framebuffer = fb;
+                if (!fb) {
+                    ctx->OMSetRenderTargets(0, nullptr, nullptr);
+                    break;
+                }
+                ID3D11RenderTargetView *rtvs[8] = {};
+                for (size_t i = 0; i < fb->rtvs.size() && i < 8; ++i) rtvs[i] = fb->rtvs[i].Get();
+                // A texture bound for sampling can't be a target too: drop it from the shader stages.
+                for (int stage = 0; stage < 2; ++stage) {
+                    std::fill(std::begin(s.srvBound[stage]), std::end(s.srvBound[stage]), nullptr);
+                }
+                ID3D11ShaderResourceView *none[64] = {};
+                ctx->VSSetShaderResources(0, 64, none);
+                ctx->PSSetShaderResources(0, 64, none);
+                s.texturesDirty = true;
+                ctx->OMSetRenderTargets(UINT(fb->rtvs.size()), rtvs, fb->dsv.Get());
+                break;
+            }
+            case Op::SET_PIPELINE: {
+                const auto *p = static_cast<const D3D11GraphicsPipeline *>(c.p0);
+                if (!p || !p->valid || p == s.pipeline) break;
+                s.pipeline = p;
+                ctx->VSSetShader(p->vs.Get(), nullptr, 0);
+                ctx->PSSetShader(p->ps.Get(), nullptr, 0);
+                ctx->IASetInputLayout(p->inputLayout.Get());
+                ctx->IASetPrimitiveTopology(p->topology);
+                ctx->RSSetState(p->rasterizer.Get());
+                {
+                    std::lock_guard lock(g_bindingsMutex);
+                    const D3D11PipelineBindings &b = g_bindings[p];
+                    const uint32_t oldConstants = s.vsBindings.constantBuffers | s.psBindings.constantBuffers;
+                    s.vsBindings = b.vs;
+                    s.psBindings = b.ps;
+                    // Stages that now read registers they didn't: rebind.
+                    if ((s.vsBindings.constantBuffers | s.psBindings.constantBuffers) != oldConstants) s.cbDirty = 0x3FFF;
+                }
+                s.texturesDirty = true;
+                s.cbDirty = 0x3FFF;
+                s.outputMergerDirty = true;
+                break;
+            }
+            case Op::SET_LAYOUT:
+                layout = static_cast<const D3D11PipelineLayout *>(c.p0);
+                break;
+            case Op::SET_DESCRIPTOR_SET:
+                BindSet(s, static_cast<const D3D11DescriptorSet *>(c.p0));
+                break;
+            case Op::SET_ROOT_DESCRIPTOR: {
+                const uint32_t reg = layout && c.a < layout->rootRegisters.size() ? layout->rootRegisters[c.a] : c.a;
+                if (reg >= 14) break;
+                s.cbBuffer[reg] = static_cast<const D3D11Buffer *>(c.p0);
+                s.cbOffset[reg] = c.offset;
+                s.cbDirty |= 1u << reg;
+                break;
+            }
+            case Op::SET_INDEX_BUFFER: {
+                auto *b = const_cast<D3D11Buffer *>(static_cast<const D3D11Buffer *>(c.p0));
+                ID3D11Buffer *gpu = b ? (b->d3d ? b->d3d.Get() : b->gpuGeometry.Get()) : nullptr;
+                ctx->IASetIndexBuffer(gpu, DXGI_FORMAT(c.a), UINT(c.offset));
+                break;
+            }
+            case Op::SET_VERTEX_BUFFERS: {
+                auto *b = const_cast<D3D11Buffer *>(static_cast<const D3D11Buffer *>(c.p0));
+                ID3D11Buffer *gpu = b ? (b->d3d ? b->d3d.Get() : b->gpuGeometry.Get()) : nullptr;
+                const UINT stride = c.b, offset = UINT(c.offset);
+                ctx->IASetVertexBuffers(c.a, 1, &gpu, &stride, &offset);
+                break;
+            }
+            case Op::SET_VIEWPORT: {
+                D3D11_VIEWPORT v = {c.f[0], c.f[1], c.f[2], c.f[3], c.f[4], c.f[5]};
+                ctx->RSSetViewports(1, &v);
+                break;
+            }
+            case Op::SET_SCISSOR: {
+                D3D11_RECT r = {c.box.left, c.box.top, c.box.right, c.box.bottom};
+                ctx->RSSetScissorRects(1, &r);
+                break;
+            }
+            case Op::SET_PUSH_CONSTANTS: {
+                if (!layout || c.a >= layout->pushRanges.size()) break;
+                const D3D11PipelineLayout::PushRange &range = layout->pushRanges[c.a];
+                if (range.reg >= 14 || c.c + c.b > sizeof(s.pushBytes[0])) break;
+                std::memcpy(s.pushBytes[range.reg] + c.c, pushData.data() + c.offset, c.b);
+                Microsoft::WRL::ComPtr<ID3D11Buffer> &cb = s.pushBuffers[range.reg];
+                if (!cb) {
+                    D3D11_BUFFER_DESC d = {};
+                    d.ByteWidth = UINT(sizeof(s.pushBytes[0]));
+                    d.Usage = D3D11_USAGE_DYNAMIC;
+                    d.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+                    d.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+                    if (FAILED(device->d3d->CreateBuffer(&d, nullptr, &cb))) break;
+                }
+                D3D11_MAPPED_SUBRESOURCE m = {};
+                if (FAILED(ctx->Map(cb.Get(), 0, D3D11_MAP_WRITE_DISCARD, 0, &m))) break;
+                std::memcpy(m.pData, s.pushBytes[range.reg], sizeof(s.pushBytes[0]));
+                ctx->Unmap(cb.Get(), 0);
+                // (the root constant buffers' flush skips a register a push range owns)
+                s.cbBuffer[range.reg] = nullptr;
+                ID3D11Buffer *b = cb.Get();
+                ctx->VSSetConstantBuffers(range.reg, 1, &b);
+                ctx->PSSetConstantBuffers(range.reg, 1, &b);
+                break;
+            }
+            case Op::SET_SLOT_TEXTURE: {
+                const auto *set = static_cast<const D3D11DescriptorSet *>(c.p0);
+                if (!set || c.a >= 64 || c.b >= set->srvs.size()) break;
+                s.srvWanted[c.a] = set->srvs[c.b];
+                s.texturesDirty = true;
+                break;
+            }
+            case Op::SET_SLOT_SAMPLER: {
+                const auto *set = static_cast<const D3D11DescriptorSet *>(c.p0);
+                if (!set || c.a >= 16 || c.b >= set->samplers.size()) break;
+                s.samplerWanted[c.a] = set->samplers[c.b];
+                s.texturesDirty = true;
+                break;
+            }
+            case Op::SET_STENCIL_REFERENCE:
+                s.stencilReference = c.a;
+                s.outputMergerDirty = true;
+                break;
+            case Op::SET_BLEND_FACTOR:
+                std::memcpy(s.blendFactor, c.f, sizeof(s.blendFactor));
+                s.outputMergerDirty = true;
+                break;
+            case Op::CLEAR_COLOR:
+                if (s.framebuffer && c.a < s.framebuffer->rtvs.size()) ctx->ClearRenderTargetView(s.framebuffer->rtvs[c.a].Get(), c.f);
+                break;
+            case Op::CLEAR_DEPTH_STENCIL:
+                if (s.framebuffer && s.framebuffer->dsv) ctx->ClearDepthStencilView(s.framebuffer->dsv.Get(), c.a, c.f[0], UINT8(c.b));
+                break;
+            case Op::DRAW:
+            case Op::DRAW_INDEXED:
+                if (!s.pipeline) break;
+                FlushTextures(s);
+                FlushConstants(s, device->d3d.Get());
+                FlushOutputMerger(s);
+                if (c.op == Op::DRAW) {
+                    if (c.b > 1 || c.d) ctx->DrawInstanced(c.a, c.b, c.c, c.d);
+                    else ctx->Draw(c.a, c.c);
+                } else {
+                    if (c.b > 1 || c.e) ctx->DrawIndexedInstanced(c.a, c.b, c.c, int32_t(c.d), c.e);
+                    else ctx->DrawIndexed(c.a, c.c, int32_t(c.d));
+                }
+                ++s.draws;
+                break;
+            case Op::COPY_TEXTURE_REGION: {
+                const auto *dst = static_cast<const D3D11Texture *>(c.p0);
+                const auto *src = static_cast<const D3D11Texture *>(c.p1);
+                if (!dst->d3d || !src->d3d) break;
+                // (Depth-stencil resources copy whole subresources only.)
+                const bool depth = (src->desc.flags & RenderTextureFlag::DEPTH_TARGET) || (dst->desc.flags & RenderTextureFlag::DEPTH_TARGET);
+                D3D11_BOX box = {UINT(c.box.left), UINT(c.box.top), UINT(c.box.front), UINT(c.box.right), UINT(c.box.bottom), UINT(c.box.back)};
+                ctx->CopySubresourceRegion(dst->d3d.Get(), c.a, depth ? 0 : c.c, depth ? 0 : c.d, depth ? 0 : c.e, src->d3d.Get(), c.b, (c.hasBox && !depth) ? &box : nullptr);
+                break;
+            }
+            case Op::UPLOAD_TEXTURE_REGION: {
+                const auto *dst = static_cast<const D3D11Texture *>(c.p0);
+                const auto *src = static_cast<const D3D11Buffer *>(c.p1);
+                if (!dst->d3d || !src || !src->cpu) break;
+                D3D11_BOX box = {UINT(c.box.left), UINT(c.box.top), UINT(c.box.front), UINT(c.box.right), UINT(c.box.bottom), UINT(c.box.back)};
+                // Clamp the box to the mip (block-rounded footprints of small mips).
+                const UINT mip = c.a % std::max(dst->desc.mipLevels, 1u);
+                const UINT w = std::max(dst->desc.width >> mip, 1u), h = std::max(dst->desc.height >> mip, 1u);
+                const UINT blockWidth = RenderFormatBlockWidth(dst->desc.format);
+                const UINT wAligned = ((w + blockWidth - 1) / blockWidth) * blockWidth, hAligned = ((h + blockWidth - 1) / blockWidth) * blockWidth;
+                box.right = std::min<UINT>(box.right, blockWidth > 1 ? wAligned : w);
+                box.bottom = std::min<UINT>(box.bottom, blockWidth > 1 ? hAligned : h);
+                if (dst->desc.dimension == RenderTextureDimension::TEXTURE_3D) {
+                    box.back = std::min<UINT>(box.back, std::max(std::max(dst->desc.depth, 1u) >> mip, 1u));
+                }
+                if (box.right <= box.left || box.bottom <= box.top) break;
+                const UINT depthPitch = c.b * UINT(c.f[0]);
+                ctx->UpdateSubresource(dst->d3d.Get(), c.a, &box, src->cpu + c.offset, c.b, depthPitch);
+                break;
+            }
+            case Op::READBACK_TEXTURE_REGION: {
+                auto *dst = const_cast<D3D11Buffer *>(static_cast<const D3D11Buffer *>(c.p0));
+                const auto *src = static_cast<const D3D11Texture *>(c.p1);
+                if (!src->d3d || !dst) break;
+                // A staging copy of the subresource, read into the buffer at map().
+                Microsoft::WRL::ComPtr<ID3D11Resource> staging;
+                UINT stagingSub = 0, stagingW = 0, stagingH = 0;
+                Microsoft::WRL::ComPtr<ID3D11Texture2D> t2;
+                if (SUCCEEDED(src->d3d.As(&t2))) {
+                    D3D11_TEXTURE2D_DESC d;
+                    t2->GetDesc(&d);
+                    const UINT mip = c.a % d.MipLevels;
+                    d.Width = std::max(d.Width >> mip, 1u);
+                    d.Height = std::max(d.Height >> mip, 1u);
+                    stagingW = d.Width, stagingH = d.Height;
+                    d.MipLevels = 1;
+                    d.ArraySize = 1;
+                    d.Usage = D3D11_USAGE_STAGING;
+                    d.BindFlags = 0;
+                    d.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+                    d.MiscFlags = 0;
+                    Microsoft::WRL::ComPtr<ID3D11Texture2D> st;
+                    if (SUCCEEDED(device->d3d->CreateTexture2D(&d, nullptr, &st))) staging = st;
+                }
+                if (!staging) {
+                    Unsupported("reading back this texture");
+                    break;
+                }
+                ctx->CopySubresourceRegion(staging.Get(), stagingSub, 0, 0, 0, src->d3d.Get(), c.a, nullptr);
+                D3D11Buffer::PendingReadback p;
+                p.staging = staging;
+                p.subresource = stagingSub;
+                p.offset = c.offset;
+                p.rowPitch = c.b;
+                p.rows = c.c;
+                p.depth = c.d;
+                {
+                    // (a staging row holds only the texture's width: the footprint's row is padded to 256
+                    // bytes - a 736-wide Created Superstar portrait read 3072 bytes from 2944-byte rows)
+                    const uint32_t blockWidth = RenderFormatBlockWidth(src->desc.format);
+                    p.rowBytes = ((stagingW + blockWidth - 1) / blockWidth) * RenderFormatSize(src->desc.format);
+                    p.stagingRows = (stagingH + blockWidth - 1) / blockWidth;
+                }
+                std::lock_guard lock(dst->readbackMutex);
+                dst->readbacks.push_back(std::move(p));
+                break;
+            }
+            case Op::COPY_TEXTURE: {
+                const auto *dst = static_cast<const D3D11Texture *>(c.p0);
+                const auto *src = static_cast<const D3D11Texture *>(c.p1);
+                if (dst->d3d && src->d3d) ctx->CopyResource(dst->d3d.Get(), src->d3d.Get());
+                break;
+            }
+            }
+        }
+        const auto t2 = std::chrono::steady_clock::now();
+        device->statDraws += s.draws;
+        device->statUploadNs += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count());
+        device->statReplayNs += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(t2 - t1).count());
+        ctx->ClearState();
+    }
+
+    // D3D11CommandQueue
+
+    std::unique_ptr<RenderCommandList> D3D11CommandQueue::createCommandList() {
+        return std::make_unique<D3D11CommandList>(device);
+    }
+
+    D3D11CommandQueue::D3D11CommandQueue(D3D11Device *device) : device(device) {
+        device->queue = this;
+        if (D3D11AsyncReplay) thread = std::thread([this] { worker(); });
+    }
+
+    D3D11CommandQueue::~D3D11CommandQueue() {
+        {
+            std::lock_guard lock(mutex);
+            stop = true;
+        }
+        work.notify_all();
+        if (thread.joinable()) thread.join();
+        if (device->queue == this) device->queue = nullptr;
+    }
+
+    void D3D11CommandQueue::worker() {
+        // (looked up: Windows 8.1 has no SetThreadDescription)
+        using SetThreadDescriptionFn = HRESULT(WINAPI *)(HANDLE, PCWSTR);
+        static const auto setThreadDescription = reinterpret_cast<SetThreadDescriptionFn>(
+            reinterpret_cast<void *>(GetProcAddress(GetModuleHandleW(L"kernel32.dll"), "SetThreadDescription")));
+        if (setThreadDescription) setThreadDescription(GetCurrentThread(), L"plume D3D11 replay");
+        for (;;) {
+            Submission s;
+            {
+                std::unique_lock lock(mutex);
+                work.wait(lock, [this] { return stop || !pending.empty(); });
+                if (pending.empty()) return;  // (stop)
+                s = std::move(pending.front());
+                pending.pop_front();
+            }
+            replay(s);
+            {
+                std::lock_guard lock(mutex);
+                replayed = s.number;
+            }
+            done.notify_all();
+        }
+    }
+
+    void D3D11CommandQueue::replay(const Submission &submission) {
+        const auto t0 = std::chrono::steady_clock::now();
+        std::lock_guard lock(*device->contextMutex);
+        const auto t1 = std::chrono::steady_clock::now();
+        device->statLockWaitNs += uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(t1 - t0).count());
+        uint32_t draws = 0;
+        for (const RenderCommandList *list : submission.lists) {
+            static_cast<const D3D11CommandList *>(list)->replay();
+            draws += static_cast<const D3D11CommandList *>(list)->drawCount;
+        }
+        if (D3D11CommandFence *fence = submission.fence) {
+            D3D11_QUERY_DESC q = {D3D11_QUERY_EVENT, 0};
+            Microsoft::WRL::ComPtr<ID3D11Query> query;
+            if (SUCCEEDED(device->d3d->CreateQuery(&q, &query))) {
+                device->context->End(query.Get());
+            }
+            std::lock_guard fenceLock(fence->mutex);
+            if (fence->submission == submission.number) fence->query = query;
+        }
+        // Light submissions are flushed (the GPU starts on them at once: steady
+        // frame pacing in the menus); heavy ones aren't - flushing made the
+        // driver process the frame on this thread (~4 ms in heavy entrances),
+        // and the fence wait (GetData) or the presenter's Present flushes them.
+        if (draws < D3D11FlushDrawLimit) {
+            device->context->Flush();
+        }
+    }
+
+    bool D3D11CommandQueue::waitReplayed(uint64_t number, uint32_t timeoutMs) {
+        if (replayed >= number) return true;
+        std::unique_lock lock(mutex);
+        auto ready = [&] { return replayed >= number; };
+        if (timeoutMs == UINT32_MAX) {
+            done.wait(lock, ready);
+            return true;
+        }
+        return done.wait_for(lock, std::chrono::milliseconds(timeoutMs), ready);
+    }
+
+    void D3D11CommandQueue::executeCommandLists(const RenderCommandList **commandLists, uint32_t commandListCount, RenderCommandSemaphore **, uint32_t, RenderCommandSemaphore **, uint32_t, RenderCommandFence *signalFence) {
+        Submission s;
+        s.lists.assign(commandLists, commandLists + commandListCount);
+        s.fence = static_cast<D3D11CommandFence *>(signalFence);
+        s.number = ++submitted;
+        if (s.fence) {
+            std::lock_guard fenceLock(s.fence->mutex);
+            s.fence->submission = s.number;
+            s.fence->query.Reset();
+        }
+        if (!thread.joinable()) {
+            replay(s);
+            replayed = s.number;
+            return;
+        }
+        {
+            std::lock_guard lock(mutex);
+            pending.push_back(std::move(s));
+        }
+        work.notify_one();
+    }
+
+    void D3D11CommandQueue::waitForCommandFence(RenderCommandFence *fence) {
+        waitForCommandFenceTimeout(fence, UINT32_MAX);
+    }
+
+    bool D3D11CommandQueue::waitForCommandFenceTimeout(RenderCommandFence *fence, uint32_t timeoutMs) {
+        auto *f = static_cast<D3D11CommandFence *>(fence);
+        if (!f) return true;
+        const auto start = std::chrono::steady_clock::now();
+        uint64_t number;
+        {
+            std::lock_guard fenceLock(f->mutex);
+            number = f->submission;
+        }
+        if (!number) return true;
+        // Replayed first (the fence's query is made then), then the GPU done.
+        if (!waitReplayed(number, timeoutMs)) return false;
+        Microsoft::WRL::ComPtr<ID3D11Query> query;
+        {
+            std::lock_guard fenceLock(f->mutex);
+            if (f->submission != number) return true;  // (signaled again since: a later wait)
+            query = f->query;
+        }
+        if (!query) return true;
+        for (uint32_t spins = 0;; ++spins) {
+            {
+                std::lock_guard lock(*device->contextMutex);
+                BOOL done = FALSE;
+                const HRESULT hr = device->context->GetData(query.Get(), &done, sizeof(done), 0);
+                if (hr == S_OK || FAILED(hr)) {
+                    return true;
+                }
+            }
+            if (timeoutMs != UINT32_MAX && std::chrono::steady_clock::now() - start >= std::chrono::milliseconds(timeoutMs)) {
+                return false;
+            }
+            if (spins < 64) std::this_thread::yield();
+            else std::this_thread::sleep_for(std::chrono::microseconds(200));
+        }
+    }
