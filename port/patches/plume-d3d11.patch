+        // The rows (of blocks) and the row pitch of a buffer-side texture copy.
+        void FootprintLayout(const RenderTextureCopyLocation &loc, uint32_t &rowPitch, uint32_t &rows) {
+            const uint32_t blockWidth = RenderFormatBlockWidth(loc.placedFootprint.format);
+            const uint32_t blockCount = (loc.placedFootprint.rowWidth + blockWidth - 1) / blockWidth;
+            rowPitch = blockCount * RenderFormatSize(loc.placedFootprint.format);
+            rows = (loc.placedFootprint.height + blockWidth - 1) / blockWidth;
+        }
