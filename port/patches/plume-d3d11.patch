+    std::unique_ptr<RenderSampler> D3D11Device::createSampler(const RenderSamplerDesc &desc) {
+        D3D11_SAMPLER_DESC d = {};
+        const bool linearMin = desc.minFilter == RenderFilter::LINEAR, linearMag = desc.magFilter == RenderFilter::LINEAR;
+        const bool linearMip = desc.mipmapMode == RenderMipmapMode::LINEAR;
+        if (desc.anisotropyEnabled) {
+            d.Filter = desc.comparisonEnabled ? D3D11_FILTER_COMPARISON_ANISOTROPIC : D3D11_FILTER_ANISOTROPIC;
+        } else {
+            d.Filter = D3D11_ENCODE_BASIC_FILTER(linearMin ? D3D11_FILTER_TYPE_LINEAR : D3D11_FILTER_TYPE_POINT,
+                                                 linearMag ? D3D11_FILTER_TYPE_LINEAR : D3D11_FILTER_TYPE_POINT,
+                                                 linearMip ? D3D11_FILTER_TYPE_LINEAR : D3D11_FILTER_TYPE_POINT, desc.comparisonEnabled);
+        }
+        d.AddressU = toD3D11(desc.addressU);
+        d.AddressV = toD3D11(desc.addressV);
+        d.AddressW = toD3D11(desc.addressW);
+        d.MipLODBias = desc.mipLODBias;
+        d.MaxAnisotropy = std::clamp<UINT>(desc.maxAnisotropy, 1, 16);
+        d.ComparisonFunc = toD3D11(desc.comparisonFunc);
+        switch (desc.borderColor) {
+        case RenderBorderColor::OPAQUE_BLACK:
+            d.BorderColor[3] = 1.0f;
+            break;
+        case RenderBorderColor::OPAQUE_WHITE:
+            d.BorderColor[0] = d.BorderColor[1] = d.BorderColor[2] = d.BorderColor[3] = 1.0f;
+            break;
+        default:
+            break;
+        }
+        d.MinLOD = desc.minLOD;
+        d.MaxLOD = desc.maxLOD;
+        auto sampler = std::make_unique<D3D11Sampler>();
+        if (FAILED(d3d->CreateSamplerState(&d, &sampler->d3d))) return nullptr;
+        return sampler;
+    }
