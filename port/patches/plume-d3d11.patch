+    ID3D11Buffer *D3D11Buffer::gpu(bool constants, uint64_t end, uint64_t generation) {
+        if (d3d) return d3d.Get();
+        if (!cpu) return nullptr;
+        if (constants && combined) return gpu(false, end, generation);
+        Microsoft::WRL::ComPtr<ID3D11Buffer> &target = constants ? gpuConstants : gpuGeometry;
+        bool &dynamic = constants ? gpuConstantsDynamic : gpuGeometryDynamic;
+        std::atomic<bool> &dirty = constants ? constantsDirty : geometryDirty;
+        const bool persistent = mapped.load();
+        end = std::min<uint64_t>(std::max<uint64_t>(end, 16), desc.size);
+        if (!target) {
+            // Rings (mapped for good) are rewritten every frame: dynamic,
+            // discarded at each upload. Others are written once: default.
+            dynamic = persistent;
+            D3D11_BUFFER_DESC d = {};
+            d.ByteWidth = UINT((desc.size + 15) & ~15ull);
+            d.Usage = dynamic ? D3D11_USAGE_DYNAMIC : D3D11_USAGE_DEFAULT;
+            d.CPUAccessFlags = dynamic ? D3D11_CPU_ACCESS_WRITE : 0;
+            d.BindFlags = constants ? D3D11_BIND_CONSTANT_BUFFER : (D3D11_BIND_VERTEX_BUFFER | D3D11_BIND_INDEX_BUFFER);
+            // A ring read as vertices, indices and constants (by offset, D3D11.1):
+            // one buffer for all three where the runtime takes it - one upload.
+            if (!constants && dynamic && device->constantBufferOffsetting && !device->noCombinedBuffers) {
+                d.BindFlags |= D3D11_BIND_CONSTANT_BUFFER;
+                combined = SUCCEEDED(device->d3d->CreateBuffer(&d, nullptr, &target));
+                if (!combined) {
+                    d.BindFlags &= ~UINT(D3D11_BIND_CONSTANT_BUFFER);
+                    device->noCombinedBuffers = true;
+                }
+            }
+            if (!target && FAILED(device->d3d->CreateBuffer(&d, nullptr, &target))) {
+                return nullptr;
+            }
+            dirty = true;
+            (constants ? constantsReady : geometryReady) = true;
+            if (combined) constantsReady = true;
+        }
+        if (dynamic) {
+            // A ring is reused only after its frame's fence (the GPU is done
+            // with it): its bytes are written without renaming (NO_OVERWRITE),
+            // and a list's later submissions add only what was appended since.
+            // DISCARD where constant buffers can't be mapped that way - a
+            // whole renamed copy of the ring each time.
+            const bool constantBound = constants || combined;
+            const bool noOverwrite = !constantBound || device->mapNoOverwriteConstants;
+            uint64_t begin = 0;
+            const int copy = constants ? 1 : 0;
+            if (noOverwrite && generation && generation == uploadedGeneration[copy] && end >= uploadedEnd[copy]) {
+                begin = uploadedEnd[copy];
+            }
+            if (end > begin || !noOverwrite) {
+                D3D11_MAPPED_SUBRESOURCE m;
+                if (SUCCEEDED(device->context->Map(target.Get(), 0, noOverwrite ? D3D11_MAP_WRITE_NO_OVERWRITE : D3D11_MAP_WRITE_DISCARD, 0, &m))) {
+                    if (!noOverwrite) begin = 0;
+                    std::memcpy(static_cast<uint8_t *>(m.pData) + begin, cpu + begin, size_t(end - begin));
+                    device->context->Unmap(target.Get(), 0);
+                }
+                device->statUploadBytes += end - begin;
+            }
+            uploadedEnd[copy] = end;
+            uploadedGeneration[copy] = generation;
+        } else if (dirty.exchange(false)) {
+            device->context->UpdateSubresource(target.Get(), 0, nullptr, cpu, 0, 0);
+        }
+        return target.Get();
+    }
