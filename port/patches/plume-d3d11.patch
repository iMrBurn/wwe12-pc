+
+    uint32_t D3D11SlotSwizzle(const RenderDescriptorSet *set, uint32_t index) {
+        const auto *s = static_cast<const D3D11DescriptorSet *>(set);
+        if (!s || index >= s->mappings.size()) return 0x688;
+        const RenderComponentMapping &m = s->mappings[index];
+        const auto code = [](RenderSwizzle w, uint32_t identity) -> uint32_t {
+            switch (w) {
+            case RenderSwizzle::R: return 0;
+            case RenderSwizzle::G: return 1;
+            case RenderSwizzle::B: return 2;
+            case RenderSwizzle::A: return 3;
+            case RenderSwizzle::ZERO: return 4;
+            case RenderSwizzle::ONE: return 5;
+            default: return identity;
+            }
+        };
+        return code(m.r, 0) | code(m.g, 1) << 3 | code(m.b, 2) << 6 | code(m.a, 3) << 9;
+    }
+
+    // A flip-model swap chain on the queue's device. Buffer 0 is always the one to draw into
+    // (DXGI rotates them), so the renderer sees one texture. Presenting waits until the queue's
+    // thread has replayed everything submitted so far.
+    struct D3D11SwapChain : RenderSwapChain {
+        D3D11CommandQueue *queue = nullptr;
+        D3D11Device *device = nullptr;
+        RenderSwapChainDesc desc;
+        Microsoft::WRL::ComPtr<IDXGISwapChain1> swapChain;
+        HANDLE waitable = nullptr;
+        UINT flags = 0;
+        bool tearing = false;
+        bool vsync = true;
+        uint32_t width = 0, height = 0;
+        std::unique_ptr<D3D11Texture> texture;
+
+        ~D3D11SwapChain() override {
+            if (queue) queue->waitReplayed(queue->submitted.load(), UINT32_MAX);
+            texture.reset();
+            if (waitable) CloseHandle(waitable);
+        }
+
+        void windowSize(uint32_t &w, uint32_t &h) const {
+            RECT rect = {};
+            GetClientRect(desc.renderWindow, &rect);
+            w = uint32_t(std::max<LONG>(rect.right - rect.left, 0));
+            h = uint32_t(std::max<LONG>(rect.bottom - rect.top, 0));
+        }
+
+        void wrapBackBuffer() {
+            Microsoft::WRL::ComPtr<ID3D11Texture2D> back;
+            texture.reset();
+            if (FAILED(swapChain->GetBuffer(0, IID_PPV_ARGS(&back)))) return;
+            RenderTextureDesc t = RenderTextureDesc::Texture2D(width, height, 1, desc.format, RenderTextureFlag::RENDER_TARGET);
+            texture = std::make_unique<D3D11Texture>(device, t, back.Get());
+        }
+
+        bool create() {
+            Microsoft::WRL::ComPtr<IDXGIDevice> dxgiDevice;
+            Microsoft::WRL::ComPtr<IDXGIAdapter> adapter;
+            Microsoft::WRL::ComPtr<IDXGIFactory2> factory;
+            if (FAILED(device->d3d.As(&dxgiDevice)) || FAILED(dxgiDevice->GetAdapter(&adapter)) ||
+                FAILED(adapter->GetParent(IID_PPV_ARGS(&factory)))) {
+                return false;
+            }
+            Microsoft::WRL::ComPtr<IDXGIFactory5> factory5;
+            BOOL allowTearing = FALSE;
+            if (SUCCEEDED(factory.As(&factory5)) &&
+                SUCCEEDED(factory5->CheckFeatureSupport(DXGI_FEATURE_PRESENT_ALLOW_TEARING, &allowTearing, sizeof(allowTearing)))) {
+                tearing = allowTearing != FALSE;
+            }
+            windowSize(width, height);
+            DXGI_SWAP_CHAIN_DESC1 d = {};
+            d.Width = width;
+            d.Height = height;
+            d.Format = toDXGI(desc.format);
+            d.SampleDesc.Count = 1;
+            d.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+            d.BufferCount = std::max(desc.textureCount, 2u);
+            d.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
+            d.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+            flags = DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT | (tearing ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+            d.Flags = flags;
+            std::lock_guard lock(*device->contextMutex);
+            if (FAILED(factory->CreateSwapChainForHwnd(device->d3d.Get(), desc.renderWindow, &d, nullptr, nullptr, &swapChain))) {
+                return false;
+            }
+            // (the game handles Alt+Enter itself)
+            factory->MakeWindowAssociation(desc.renderWindow, DXGI_MWA_NO_ALT_ENTER);
+            Microsoft::WRL::ComPtr<IDXGISwapChain2> swapChain2;
+            if (SUCCEEDED(swapChain.As(&swapChain2))) {
+                swapChain2->SetMaximumFrameLatency(std::max(desc.maxFrameLatency, 1u));
+                waitable = swapChain2->GetFrameLatencyWaitableObject();
+            }
+            wrapBackBuffer();
+            return texture != nullptr;
+        }
+
+        bool present(uint32_t, RenderCommandSemaphore **, uint32_t) override {
+            queue->waitReplayed(queue->submitted.load(), UINT32_MAX);
+            std::lock_guard lock(*device->contextMutex);
+            const UINT presentFlags = (!vsync && tearing) ? DXGI_PRESENT_ALLOW_TEARING : 0;
+            return SUCCEEDED(swapChain->Present(vsync ? 1 : 0, presentFlags));
+        }
+
+        void wait() override {
+            if (waitable) WaitForSingleObjectEx(waitable, 1000, TRUE);
+        }
+
+        bool resize() override {
+            uint32_t w = 0, h = 0;
+            windowSize(w, h);
+            if (!w || !h) return false;
+            queue->waitReplayed(queue->submitted.load(), UINT32_MAX);
+            std::lock_guard lock(*device->contextMutex);
+            texture.reset();
+            // (the last replay leaves the back buffer bound)
+            device->context->ClearState();
+            device->context->Flush();
+            if (FAILED(swapChain->ResizeBuffers(0, w, h, DXGI_FORMAT_UNKNOWN, flags))) return false;
+            width = w;
+            height = h;
+            wrapBackBuffer();
+            return texture != nullptr;
+        }
+
+        bool needsResize() const override {
+            uint32_t w = 0, h = 0;
+            windowSize(w, h);
+            return !swapChain || w != width || h != height;
+        }
+
+        void setVsyncEnabled(bool enabled) override { vsync = enabled; }
+        bool isVsyncEnabled() const override { return vsync; }
+        uint32_t getWidth() const override { return width; }
+        uint32_t getHeight() const override { return height; }
+        RenderTexture *getTexture(uint32_t) override { return texture.get(); }
+        uint32_t getTextureCount() const override { return 1; }
+
+        bool acquireTexture(RenderCommandSemaphore *, uint32_t *textureIndex) override {
+            if (textureIndex) *textureIndex = 0;
+            return texture != nullptr;
+        }
+
+        RenderWindow getWindow() const override { return desc.renderWindow; }
+        bool isEmpty() const override { return !swapChain || !width || !height; }
+        uint32_t getRefreshRate() const override { return 0; }
+    };
+
+    std::unique_ptr<RenderSwapChain> D3D11CommandQueue::createSwapChain(const RenderSwapChainDesc &desc) {
+        auto swapChain = std::make_unique<D3D11SwapChain>();
+        swapChain->queue = this;
+        swapChain->device = device;
+        swapChain->desc = desc;
+        if (!swapChain->create()) return nullptr;
+        return swapChain;
+    }
+
+    // The standalone interface: lists the hardware adapters, and creates the device on the one
+    // asked for by name (or, when the name is another API's for the same GPU, by its vendor).
+    struct D3D11OwnInterface : RenderInterface {
+        Microsoft::WRL::ComPtr<IDXGIFactory1> factory;
+        std::vector<Microsoft::WRL::ComPtr<IDXGIAdapter1>> adapters;
+        std::vector<std::string> deviceNames;
+        RenderInterfaceCapabilities capabilities;
+        std::recursive_mutex contextMutex;
+        Microsoft::WRL::ComPtr<ID3D11Device> device;
+        Microsoft::WRL::ComPtr<ID3D11DeviceContext> context;
+
+        bool init() {
+            if (FAILED(CreateDXGIFactory1(IID_PPV_ARGS(&factory)))) return false;
+            Microsoft::WRL::ComPtr<IDXGIAdapter1> adapter;
+            for (UINT i = 0; factory->EnumAdapters1(i, &adapter) != DXGI_ERROR_NOT_FOUND; ++i) {
+                DXGI_ADAPTER_DESC1 d = {};
+                adapter->GetDesc1(&d);
+                if (!(d.Flags & DXGI_ADAPTER_FLAG_SOFTWARE)) {
+                    char name[256] = {};
+                    WideCharToMultiByte(CP_UTF8, 0, d.Description, -1, name, sizeof(name) - 1, nullptr, nullptr);
+                    deviceNames.push_back(name);
+                    adapters.push_back(adapter);
+                }
+                adapter.Reset();
+            }
+            capabilities.shaderFormat = RenderShaderFormat::DXBC;
+            return !adapters.empty();
+        }
+
+        static bool sameVendor(const std::string &a, const std::string &b) {
+            const auto has = [](const std::string &s, const char *w) { return s.find(w) != std::string::npos; };
+            for (const char *v : {"Intel", "NVIDIA", "GeForce", "AMD", "Radeon"}) {
+                if (has(a, v) && (has(b, v) || (std::string(v) == "GeForce" && has(b, "NVIDIA")) ||
+                                  (std::string(v) == "Radeon" && has(b, "AMD")))) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
+        std::unique_ptr<RenderDevice> createDevice(const std::string &preferredDeviceName) override {
+            size_t pick = 0;
+            bool found = false;
+            for (size_t i = 0; i < deviceNames.size() && !found; ++i) {
+                if (deviceNames[i] == preferredDeviceName) { pick = i; found = true; }
+            }
+            for (size_t i = 0; i < deviceNames.size() && !found && !preferredDeviceName.empty(); ++i) {
+                if (sameVendor(preferredDeviceName, deviceNames[i])) { pick = i; found = true; }
+            }
+            static const D3D_FEATURE_LEVEL kLevels[] = {D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0};
+            UINT flags = D3D11_CREATE_DEVICE_BGRA_SUPPORT;
+            HRESULT hr = D3D11CreateDevice(adapters[pick].Get(), D3D_DRIVER_TYPE_UNKNOWN, nullptr, flags, kLevels,
+                                           UINT(std::size(kLevels)), D3D11_SDK_VERSION, &device, nullptr, &context);
+            if (hr == E_INVALIDARG) {  // (11_1 unknown to an old runtime)
+                hr = D3D11CreateDevice(adapters[pick].Get(), D3D_DRIVER_TYPE_UNKNOWN, nullptr, flags, kLevels + 1, 1,
+                                       D3D11_SDK_VERSION, &device, nullptr, &context);
+            }
+            if (FAILED(hr)) return nullptr;
+            Microsoft::WRL::ComPtr<ID3D11Multithread> multithread;
+            if (SUCCEEDED(context.As(&multithread))) multithread->SetMultithreadProtected(TRUE);
+            D3D11_FEATURE_DATA_D3D11_OPTIONS options = {};
+            const bool offsetting = SUCCEEDED(device->CheckFeatureSupport(D3D11_FEATURE_D3D11_OPTIONS, &options, sizeof(options))) &&
+                                    options.ConstantBufferOffsetting;
+            return std::make_unique<D3D11Device>(device.Get(), context.Get(), &contextMutex, offsetting);
+        }
+
+        const std::vector<std::string> &getDeviceNames() const override { return deviceNames; }
+        const RenderInterfaceCapabilities &getCapabilities() const override { return capabilities; }
+    };
+
+    std::unique_ptr<RenderInterface> CreateD3D11Interface() {
+        auto api = std::make_unique<D3D11OwnInterface>();
+        if (!api->init()) return nullptr;
+        return api;
+    }
+};
