+    std::unique_ptr<RenderPipeline> D3D11Device::createGraphicsPipeline(const RenderGraphicsPipelineDesc &desc) {
+        auto pipeline = std::make_unique<D3D11GraphicsPipeline>();
+        const auto *vs = static_cast<const D3D11Shader *>(desc.vertexShader);
+        const auto *ps = static_cast<const D3D11Shader *>(desc.pixelShader);
+        if (!vs || !vs->vs) return pipeline;  // (valid = false)
+        pipeline->vs = vs->vs;
+        if (ps) pipeline->ps = ps->ps;
+        D3D11PipelineBindings bindings;
+        bindings.vs = ReadBindings(vs->code);
+        if (ps) bindings.ps = ReadBindings(ps->code);
+
+        // Input layout.
+        if (desc.inputElementsCount) {
+            std::vector<D3D11_INPUT_ELEMENT_DESC> elements(desc.inputElementsCount);
+            for (uint32_t i = 0; i < desc.inputElementsCount; ++i) {
+                const RenderInputElement &e = desc.inputElements[i];
+                D3D11_INPUT_ELEMENT_DESC &d = elements[i];
+                d.SemanticName = e.semanticName;
+                d.SemanticIndex = e.semanticIndex;
+                d.Format = toDXGI(e.format);
+                d.InputSlot = e.slotIndex;
+                d.AlignedByteOffset = e.alignedByteOffset;
+                d.InputSlotClass = D3D11_INPUT_PER_VERTEX_DATA;
+                for (uint32_t s = 0; s < desc.inputSlotsCount; ++s) {
+                    if (desc.inputSlots[s].index == e.slotIndex && desc.inputSlots[s].classification == RenderInputSlotClassification::PER_INSTANCE_DATA) {
+                        d.InputSlotClass = D3D11_INPUT_PER_INSTANCE_DATA;
+                        d.InstanceDataStepRate = 1;
+                    }
+                }
+            }
+            if (FAILED(d3d->CreateInputLayout(elements.data(), UINT(elements.size()), vs->code.data(), vs->code.size(), &pipeline->inputLayout))) {
+                return pipeline;
+            }
+        }
+        for (uint32_t s = 0; s < desc.inputSlotsCount; ++s) {
+            if (desc.inputSlots[s].index < D3D11_IA_VERTEX_INPUT_RESOURCE_SLOT_COUNT) pipeline->strides[desc.inputSlots[s].index] = desc.inputSlots[s].stride;
+        }
+
+        // Blend.
+        D3D11_BLEND_DESC blend = {};
+        blend.AlphaToCoverageEnable = desc.alphaToCoverageEnabled;
+        blend.IndependentBlendEnable = desc.renderTargetCount > 1;
+        for (uint32_t i = 0; i < std::max(desc.renderTargetCount, 1u) && i < 8; ++i) {
+            const RenderBlendDesc &b = desc.renderTargetBlend[i];
+            D3D11_RENDER_TARGET_BLEND_DESC &d = blend.RenderTarget[i];
+            d.BlendEnable = b.blendEnabled;
+            d.SrcBlend = toD3D11(b.srcBlend);
+            d.DestBlend = toD3D11(b.dstBlend);
+            d.BlendOp = toD3D11(b.blendOp);
+            // (alpha factors can't be colour ones in D3D11)
+            auto alpha = [](RenderBlend f) {
+                switch (f) {
+                case RenderBlend::SRC_COLOR: return RenderBlend::SRC_ALPHA;
+                case RenderBlend::INV_SRC_COLOR: return RenderBlend::INV_SRC_ALPHA;
+                case RenderBlend::DEST_COLOR: return RenderBlend::DEST_ALPHA;
+                case RenderBlend::INV_DEST_COLOR: return RenderBlend::INV_DEST_ALPHA;
+                case RenderBlend::SRC1_COLOR: return RenderBlend::SRC1_ALPHA;
+                case RenderBlend::INV_SRC1_COLOR: return RenderBlend::INV_SRC1_ALPHA;
+                default: return f;
+                }
+            };
+            d.SrcBlendAlpha = toD3D11(alpha(b.srcBlendAlpha));
+            d.DestBlendAlpha = toD3D11(alpha(b.dstBlendAlpha));
+            d.BlendOpAlpha = toD3D11(b.blendOpAlpha);
+            d.RenderTargetWriteMask = b.renderTargetWriteMask;
+        }
+        // Rasterizer.
+        D3D11_RASTERIZER_DESC raster = {};
+        raster.FillMode = D3D11_FILL_SOLID;
+        raster.CullMode = desc.cullMode == RenderCullMode::FRONT ? D3D11_CULL_FRONT : desc.cullMode == RenderCullMode::BACK ? D3D11_CULL_BACK : D3D11_CULL_NONE;
+        raster.FrontCounterClockwise = desc.frontFace == RenderFrontFace::COUNTER_CLOCKWISE;
+        raster.DepthBias = desc.depthBias;
+        raster.DepthBiasClamp = desc.depthBiasClamp;
+        raster.SlopeScaledDepthBias = desc.slopeScaledDepthBias;
+        raster.DepthClipEnable = desc.depthClipEnabled;
+        raster.ScissorEnable = TRUE;
+        // Depth / stencil.
+        D3D11_DEPTH_STENCIL_DESC depth = {};
+        depth.DepthEnable = desc.depthEnabled;
+        depth.DepthWriteMask = desc.depthWriteEnabled ? D3D11_DEPTH_WRITE_MASK_ALL : D3D11_DEPTH_WRITE_MASK_ZERO;
+        depth.DepthFunc = toD3D11(desc.depthFunction);
+        depth.StencilEnable = desc.stencilEnabled;
+        depth.StencilReadMask = UINT8(desc.stencilReadMask);
+        depth.StencilWriteMask = UINT8(desc.stencilWriteMask);
+        auto face = [](const RenderStencilFaceDesc &f) {
+            D3D11_DEPTH_STENCILOP_DESC d;
+            d.StencilFailOp = toD3D11(f.failOp);
+            d.StencilDepthFailOp = toD3D11(f.depthFailOp);
+            d.StencilPassOp = toD3D11(f.passOp);
+            d.StencilFunc = toD3D11(f.compareFunction);
+            return d;
+        };
+        depth.FrontFace = face(desc.stencilFrontFace);
+        depth.BackFace = face(desc.stencilBackFace);
+        if (FAILED(d3d->CreateBlendState(&blend, &pipeline->blend)) || FAILED(d3d->CreateRasterizerState(&raster, &pipeline->rasterizer)) ||
+            FAILED(d3d->CreateDepthStencilState(&depth, &pipeline->depthStencil))) {
+            return pipeline;
+        }
+        pipeline->topology = toD3D11(desc.primitiveTopology);
+        pipeline->stencilReference = desc.stencilReference;
+        pipeline->dynamicStencilReference = false;  // (WWE '12: not in our plume)
+        pipeline->dynamicBlendFactor = false;
+        pipeline->valid = true;
+        {
+            std::lock_guard lock(g_bindingsMutex);
+            g_bindings[pipeline.get()] = bindings;
+        }
+        return pipeline;
+    }
