+        // Logs an unsupported call once per kind.
+        void Unsupported(const char *what) {
+            static std::mutex mutex;
+            static std::vector<const char *> logged;
+            std::lock_guard lock(mutex);
+            if (std::find(logged.begin(), logged.end(), what) != logged.end()) {
+                return;
+            }
+            logged.push_back(what);
+            char message[256];
+            std::snprintf(message, sizeof(message), "plume D3D11: %s is not supported", what);
+            if (D3D11LogFunction) D3D11LogFunction(message);
+            else std::fprintf(stderr, "%s\n", message);
+        }
