+    std::unique_ptr<RenderPipelineLayout> D3D11Device::createPipelineLayout(const RenderPipelineLayoutDesc &desc) {
+        auto layout = std::make_unique<D3D11PipelineLayout>();
+        for (uint32_t i = 0; i < desc.rootDescriptorDescsCount; ++i) {
+            layout->rootRegisters.push_back(uint8_t(desc.rootDescriptorDescs[i].shaderRegister));
+        }
+        for (uint32_t i = 0; i < desc.pushConstantRangesCount; ++i) {
+            D3D11PipelineLayout::PushRange range;
+            range.reg = uint8_t(desc.pushConstantRanges[i].binding);
+            range.size = desc.pushConstantRanges[i].size;
+            layout->pushRanges.push_back(range);
+        }
+        return layout;
+    }
