+        uint32_t SubresourceOf(const D3D11Texture *texture, uint32_t mipLevel, uint32_t arrayIndex) {
+            return D3D11CalcSubresource(mipLevel, arrayIndex, std::max(texture->desc.mipLevels, 1u));
+        }
+
+        // What a shader's DXBC binds (its RDEF chunk): texture (t#), sampler
+        // (s#) and constant buffer (b#) registers.
+        struct ShaderBindings {
+            uint64_t textures = 0;
+            uint32_t samplers = 0;
+            uint32_t constantBuffers = 0;
+        };
+
+        ShaderBindings ReadBindings(const std::vector<uint8_t> &code) {
+            ShaderBindings out;
+            if (code.size() < 32 || std::memcmp(code.data(), "DXBC", 4) != 0) {
+                out.textures = ~0ull;
+                out.samplers = 0xFFFF;
+                out.constantBuffers = 0x3FFF;
+                return out;
+            }
+            uint32_t chunkCount;
+            std::memcpy(&chunkCount, code.data() + 28, 4);
+            for (uint32_t c = 0; c < chunkCount && 32 + 4 * (c + 1) <= code.size(); ++c) {
+                uint32_t chunkOffset;
+                std::memcpy(&chunkOffset, code.data() + 32 + 4 * c, 4);
+                if (chunkOffset + 8 > code.size() || std::memcmp(code.data() + chunkOffset, "RDEF", 4) != 0) {
+                    continue;
+                }
+                const uint8_t *rdef = code.data() + chunkOffset + 8;
+                uint32_t bindingCount, bindingOffset;
+                std::memcpy(&bindingCount, rdef + 8, 4);
+                std::memcpy(&bindingOffset, rdef + 12, 4);
+                for (uint32_t i = 0; i < bindingCount; ++i) {
+                    // Name, type, return type, dimension, samples, bind point, bind count, flags.
+                    uint32_t b[8];
+                    std::memcpy(b, rdef + bindingOffset + 32 * i, 32);
+                    const uint32_t type = b[1], point = b[5], count = std::max(b[6], 1u);
+                    for (uint32_t r = point; r < point + count; ++r) {
+                        if (type == 2 /* D3D_SIT_TEXTURE */ && r < 64) out.textures |= 1ull << r;
+                        else if (type == 3 /* D3D_SIT_SAMPLER */ && r < 16) out.samplers |= 1u << r;
+                        else if (type == 0 /* D3D_SIT_CBUFFER */ && r < 14) out.constantBuffers |= 1u << r;
+                    }
+                }
+                return out;
+            }
+            // No reflection (stripped): everything.
+            out.textures = ~0ull;
+            out.samplers = 0xFFFF;
+            out.constantBuffers = 0x3FFF;
+            return out;
+        }
+
+        struct D3D11PipelineBindings {
+            ShaderBindings vs, ps;
+        };
+        std::mutex g_bindingsMutex;
+        std::unordered_map<const D3D11GraphicsPipeline *, D3D11PipelineBindings> g_bindings;
+    }
