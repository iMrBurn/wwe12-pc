+    std::unique_ptr<RenderFramebuffer> D3D11Device::createFramebuffer(const RenderFramebufferDesc &desc) {
+        auto fb = std::make_unique<D3D11Framebuffer>();
+        for (uint32_t i = 0; i < desc.colorAttachmentsCount; ++i) {
+            const auto *view = desc.colorAttachmentViews && desc.colorAttachmentViews[i] ? static_cast<const D3D11TextureView *>(desc.colorAttachmentViews[i]) : nullptr;
+            const auto *texture = view ? view->texture : static_cast<const D3D11Texture *>(desc.colorAttachments[i]);
+            if (!texture || !texture->d3d) return nullptr;
+            D3D11_RENDER_TARGET_VIEW_DESC d = {};
+            d.Format = toDXGI(view && view->desc.format != RenderFormat::UNKNOWN ? view->desc.format : texture->desc.format);
+            d.ViewDimension = D3D11_RTV_DIMENSION_TEXTURE2D;
+            d.Texture2D.MipSlice = view ? view->desc.mipSlice : 0;
+            Microsoft::WRL::ComPtr<ID3D11RenderTargetView> rtv;
+            if (FAILED(d3d->CreateRenderTargetView(texture->d3d.Get(), &d, &rtv))) return nullptr;
+            fb->rtvs.push_back(rtv);
+            fb->width = std::max(texture->desc.width >> d.Texture2D.MipSlice, 1u);
+            fb->height = std::max(texture->desc.height >> d.Texture2D.MipSlice, 1u);
+        }
+        if (desc.depthAttachment || desc.depthAttachmentView) {
+            const auto *view = static_cast<const D3D11TextureView *>(desc.depthAttachmentView);
+            const auto *texture = view ? view->texture : static_cast<const D3D11Texture *>(desc.depthAttachment);
+            if (!texture || !texture->d3d) return nullptr;
+            D3D11_DEPTH_STENCIL_VIEW_DESC d = {};
+            d.Format = toDXGIDepthStencilView(texture->desc.format);
+            d.ViewDimension = D3D11_DSV_DIMENSION_TEXTURE2D;
+            d.Flags = desc.depthAttachmentReadOnly ? (D3D11_DSV_READ_ONLY_DEPTH | D3D11_DSV_READ_ONLY_STENCIL) : 0;
+            if (FAILED(d3d->CreateDepthStencilView(texture->d3d.Get(), &d, &fb->dsv))) return nullptr;
+            if (!fb->width) {
+                fb->width = texture->desc.width;
+                fb->height = texture->desc.height;
+            }
+        }
+        return fb;
+    }
