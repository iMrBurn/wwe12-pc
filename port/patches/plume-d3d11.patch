+    D3D11Buffer::D3D11Buffer(D3D11Device *device, const RenderBufferDesc &desc) : device(device), desc(desc) {
+        if (desc.heapType == RenderHeapType::UPLOAD || desc.heapType == RenderHeapType::READBACK) {
+            cpu = static_cast<uint8_t *>(_aligned_malloc(size_t(std::max<uint64_t>(desc.size, 16)), 16));
+            if (cpu) std::memset(cpu, 0, size_t(desc.size));
+            return;
+        }
+        D3D11_BUFFER_DESC d = {};
+        d.ByteWidth = UINT((desc.size + 15) & ~15ull);
+        d.Usage = D3D11_USAGE_DEFAULT;
+        if (desc.flags & RenderBufferFlag::VERTEX) d.BindFlags |= D3D11_BIND_VERTEX_BUFFER;
+        if (desc.flags & RenderBufferFlag::INDEX) d.BindFlags |= D3D11_BIND_INDEX_BUFFER;
+        if (desc.flags & RenderBufferFlag::CONSTANT) d.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+        device->d3d->CreateBuffer(&d, nullptr, &d3d);
+    }
+
+    D3D11Buffer::~D3D11Buffer() {
+        if (cpu) _aligned_free(cpu);
+    }
+
+    void *D3D11Buffer::map(uint32_t subresource, const RenderRange *readRange) {
+        if (desc.heapType == RenderHeapType::READBACK) {
+            std::vector<PendingReadback> pending;
+            {
+                std::lock_guard lock(readbackMutex);
+                pending.swap(readbacks);
+            }
+            if (!pending.empty()) {
+                std::lock_guard lock(*device->contextMutex);
+                for (const PendingReadback &p : pending) {
+                    D3D11_MAPPED_SUBRESOURCE mapped;
+                    if (FAILED(device->context->Map(p.staging.Get(), p.subresource, D3D11_MAP_READ, 0, &mapped))) {
+                        continue;
+                    }
+                    // Per row: the bytes the staging row holds (not the buffer's padded pitch - reading that
+                    // much ran past the staging copy's end on the last row).
+                    const uint32_t bytes = std::min({p.rowPitch, p.rowBytes ? p.rowBytes : p.rowPitch, uint32_t(mapped.RowPitch)});
+                    const uint32_t rows = p.stagingRows ? std::min(p.rows, p.stagingRows) : p.rows;
+                    for (uint32_t z = 0; z < p.depth; ++z) {
+                        for (uint32_t y = 0; y < rows; ++y) {
+                            const uint64_t dst = p.offset + (uint64_t(z) * p.rows + y) * p.rowPitch;
+                            if (dst + bytes > desc.size) break;
+                            std::memcpy(cpu + dst, static_cast<const uint8_t *>(mapped.pData) + size_t(z) * mapped.DepthPitch + size_t(y) * mapped.RowPitch, bytes);
+                        }
+                    }
+                    device->context->Unmap(p.staging.Get(), p.subresource);
+                }
+            }
+            return cpu;
+        }
+        if (cpu) {
+            mapped = true;
+            return cpu;
+        }
+        Unsupported("mapping a DEFAULT heap buffer");
+        return nullptr;
+    }
+
+    void D3D11Buffer::unmap(uint32_t subresource, const RenderRange *writtenRange) {
+        if (desc.heapType == RenderHeapType::UPLOAD) {
+            mapped = false;
+            geometryDirty = true;
+            constantsDirty = true;
+        }
+    }
