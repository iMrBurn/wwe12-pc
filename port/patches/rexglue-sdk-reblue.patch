+void XmaContext::EnterInputBuffer(XMA_CONTEXT_DATA* data, uint32_t packets_to_skip) {
+  pending_packet_skip_ = packets_to_skip;
+  data->input_buffer_read_offset = kBitsPerPacketHeader;
+  if (!data->IsCurrentInputBufferValid()) {
+    return;  // Applied when the game hands over the next buffer.
+  }
+  uint8_t* buffer = memory()->TranslatePhysical(data->GetCurrentInputBufferAddress());
+  const uint32_t packet_count = data->GetCurrentInputBufferPacketCount();
+  uint32_t past_end = 0;
+  const uint32_t offset =
+      GetNextPacketReadOffset(buffer, packets_to_skip, packet_count, &past_end);
+  if (offset == kBitsPerPacketHeader && packets_to_skip < packet_count &&
+      xma::GetPacketFrameOffset(buffer + packets_to_skip * kBytesPerPacket) ==
+          kBitsPerPacketHeader) {
