+// WWE '12 port: the runtime has a single profile, user 0. Any player with a connected device (the
+// keyboard set to player 2, a second pad, a pad that came up as slot 1) is signed in with it, so the
+// game's "press START" screen accepts START from whichever device the player uses instead of
+// reporting that no profile is signed in. Slots without a device stay signed out.
+static uint32_t ProfileSlot(uint32_t user_index) {
+  if (user_index == 0 || user_index >= 4) {
+    return user_index;
+  }
+  auto* input = static_cast<rex::input::InputSystem*>(REX_KERNEL_STATE()->emulator()->input_system());
+  if (!input) {
+    return user_index;
+  }
+  rex::input::X_INPUT_CAPABILITIES caps = {};
+  return input->GetCapabilities(user_index, 1 /* gamepad */, &caps) == X_ERROR_SUCCESS ? 0 : user_index;
+}
