+// Audio flow diagnostics. The mix (SDLCallback) samples the counters once per
+// window and logs one line: how many frames the game pushed (SubmitFrame), how
+// many were consumed from the queue, and how many empty frames were filled
+// with silence. When game sound dies, this tells whether the producer, the
+// pump (audio worker semaphore) or the mix went quiet.
+struct AudioFlow {
+  std::atomic<uint32_t> submits;   // frames pushed by the game
+  std::atomic<uint32_t> consumed;  // frames taken from the queue
+  std::atomic<uint32_t> silences;  // empty-queue frames filled with silence
+  std::atomic<float> peak;         // largest |sample| of the window's consumed frames
+  std::chrono::steady_clock::time_point window_start;  // epoch: first sample immediate
+};
+
+AudioFlow& Flow() {
+  static AudioFlow flow{};
+  return flow;
+}
+
+}  // namespace
