@@ -47,4 +47,10 @@ std::unique_ptr<CommandProcessor> D3D12GraphicsSystem::CreateCommandProcessor()
   return std::unique_ptr<CommandProcessor>(new D3D12CommandProcessor(this, kernel_state_));
 }
 
+void D3D12GraphicsSystem::LogHostGpuLossDiagnostics() {
+  if (auto* cp = static_cast<D3D12CommandProcessor*>(command_processor())) {
+    cp->LogHostGpuLossDiagnostics();
+  }
+}
+
 }  // namespace rex::graphics::d3d12
diff --git a/src/graphics/graphics_system.cpp b/src/graphics/graphics_system.cpp
index 8f2fcb0..5e7ef96 100644
--- a/src/graphics/graphics_system.cpp
+++ b/src/graphics/graphics_system.cpp
@@ -217,6 +217,11 @@ void GraphicsSystem::OnHostGpuLossFromAnyThread([[maybe_unused]] bool is_respons
   if (host_gpu_loss_reported_.test_and_set(std::memory_order_relaxed)) {
     return;
   }
+  // Record why the device was lost (DRED on D3D12) before aborting: the
+  // presenter usually notices the loss first, before the command processor
+  // gets a chance to log anything.
+  LogHostGpuLossDiagnostics();
+  rex::FlushLogging();
   rex::FatalError("Graphics device lost (probably due to an internal error)");
 }
 
diff --git a/src/ui/d3d12/d3d12_provider.cpp b/src/ui/d3d12/d3d12_provider.cpp
