+void D3D12CommandProcessor::LogHostGpuLossDiagnostics() {
+  ID3D12Device* device = GetD3D12Provider().GetDevice();
+  HRESULT reason = device ? device->GetDeviceRemovedReason() : S_OK;
+  if (FAILED(reason)) {
+    LogDeviceRemovalDiagnostics(device, reason);
+  }
+}
+
 void D3D12CommandProcessor::LogDeviceRemovalDiagnostics(ID3D12Device* device, HRESULT reason) {
   const char* reason_str = "Unknown";
   switch (reason) {
@@ -3238,6 +3260,69 @@ void D3D12CommandProcessor::LogDeviceRemovalDiagnostics(ID3D12Device* device, HR
         REXGPU_ERROR("  [{}] op type {}{}", i, static_cast<int>(node->pCommandHistory[i]),
                      i == last ? " <-- FAULT" : "");
       }
+
+      // Name the faulting draw from our own draw history. Each guest draw is
+      // preceded by exactly one SETMARKER (gpu_debug_markers) and nothing else
+      // sets markers, whereas internal draws (render target transfers...) have
+      // none: the last marker before the fault is the hung guest draw.
+      uint32_t markers_before = 0, draws_total = 0;
+      for (uint32_t i = 0; i < node->BreadcrumbCount; i++) {
+        if (node->pCommandHistory[i] == D3D12_AUTO_BREADCRUMB_OP_SETMARKER) {
+          draws_total++;
+          if (i < last) {
+            markers_before++;
+          }
+        }
+      }
+      if (!markers_before) {
+        continue;
+      }
+      uint32_t draws_before = markers_before - 1;
+      std::lock_guard<std::mutex> lock(draw_history_mutex_);
+      for (auto it = draw_history_.rbegin(); it != draw_history_.rend(); ++it) {
+        const std::vector<DrawRecord>& draws = it->second;
+        if (draws.size() != draws_total) {
+          continue;
+        }
+        REXGPU_ERROR("DRED: faulting draw #{} of {} in submission {}", draws_before, draws_total,
+                     it->first);
+        uint32_t from = draws_before > 2 ? draws_before - 2 : 0;
+        for (uint32_t d = from; d <= draws_before && d < draws.size(); d++) {
+          const DrawRecord& r = draws[d];
+          REXGPU_ERROR("  draw #{}: VS {:016X} PS {:016X} vertices={} memexport={}{}", d,
+                       r.vertex_shader_hash, r.pixel_shader_hash, r.vertex_count, r.memexport,
+                       d == draws_before ? " <-- FAULT" : "");
+        }
+        break;
+      }
+    }
+  }
+
+  // Marker strings (gpu_debug_markers) attached to the breadcrumbs: the last
+  // ones before the faulting op identify the hung draw's shaders.
+  Microsoft::WRL::ComPtr<ID3D12DeviceRemovedExtendedData1> dred1;
+  D3D12_DRED_AUTO_BREADCRUMBS_OUTPUT1 breadcrumbs1 = {};
+  if (SUCCEEDED(dred.As(&dred1)) && SUCCEEDED(dred1->GetAutoBreadcrumbsOutput1(&breadcrumbs1))) {
+    for (const D3D12_AUTO_BREADCRUMB_NODE1* node = breadcrumbs1.pHeadAutoBreadcrumbNode; node;
+         node = node->pNext) {
+      if (!node->pLastBreadcrumbValue || *node->pLastBreadcrumbValue == 0 ||
+          !node->pBreadcrumbContexts) {
+        continue;
+      }
+      uint32_t last = std::min(*node->pLastBreadcrumbValue, node->BreadcrumbCount);
+      uint32_t shown = 0;
+      for (uint32_t c = node->BreadcrumbContextsCount; c-- > 0 && shown < 3;) {
+        const D3D12_DRED_BREADCRUMB_CONTEXT& ctx = node->pBreadcrumbContexts[c];
+        if (ctx.BreadcrumbIndex > last || !ctx.pContextString) {
+          continue;
+        }
+        std::string text;
+        for (const wchar_t* p = ctx.pContextString; *p; ++p) {
+          text.push_back(*p < 0x80 ? static_cast<char>(*p) : '?');
+        }
+        REXGPU_ERROR("  marker before op [{}]: {}", ctx.BreadcrumbIndex, text);
+        ++shown;
+      }
     }
   }
 
@@ -3442,6 +3527,15 @@ bool D3D12CommandProcessor::EndSubmission(bool is_swap) {
       command_allocator_writable_last_ = nullptr;
     }
 
+    if (debug_markers_enabled_) {
+      std::lock_guard<std::mutex> lock(draw_history_mutex_);
+      draw_history_.emplace_back(submission_current_, std::move(draws_current_submission_));
+      draws_current_submission_.clear();
+      while (draw_history_.size() > 16) {
+        draw_history_.pop_front();
+      }
+    }
+
     direct_queue->Signal(submission_fence_, submission_current_++);
 
     submission_open_ = false;
diff --git a/src/graphics/d3d12/deferred_command_list.cpp b/src/graphics/d3d12/deferred_command_list.cpp
index e6d6277..122d458 100644
--- a/src/graphics/d3d12/deferred_command_list.cpp
+++ b/src/graphics/d3d12/deferred_command_list.cpp
@@ -266,7 +266,16 @@ void DeferredCommandList::Execute(ID3D12GraphicsCommandList* command_list,
         auto& args = *reinterpret_cast<const DebugMarkerHeader*>(stream);
         const char* label_name = reinterpret_cast<const char*>(
             reinterpret_cast<const uint8_t*>(stream) + sizeof(DebugMarkerHeader));
-        command_list->SetMarker(1, label_name, static_cast<UINT>(args.label_length + 1));
+        // Unicode (metadata 0, PIX's WINPIX_EVENT_UNICODE_VERSION): DRED only
+        // records marker strings in this form (breadcrumb contexts).
+        wchar_t wide_label[256];
+        size_t wide_length = std::min<size_t>(args.label_length, std::size(wide_label) - 1);
+        for (size_t i = 0; i < wide_length; ++i) {
+          wide_label[i] = static_cast<unsigned char>(label_name[i]);
+        }
+        wide_label[wide_length] = L'\0';
+        command_list->SetMarker(0, wide_label,
+                                static_cast<UINT>((wide_length + 1) * sizeof(wchar_t)));
       } break;
       default:
         assert_unhandled_case(header.command);
diff --git a/src/graphics/d3d12/graphics_system.cpp b/src/graphics/d3d12/graphics_system.cpp
