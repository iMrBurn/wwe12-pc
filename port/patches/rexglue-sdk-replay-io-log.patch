+REXCVAR_DEFINE_BOOL(replay_io_log, false, "Kernel",
+                    "WWE '12 port, diagnostic: log the game's opens, reads and writes of its replay "
+                    "file (cache:\\Spectacular.rps) as [replayio] lines.");
+
 namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
 
+// replay_io_log: the first 40 calls of each kind, then one in 200, and every failure.
+static void NoteReplayIo(const char* op, const std::string& path, uint64_t offset, uint32_t length,
+                         uint32_t done, X_STATUS result) {
+  if (!REXCVAR_GET(replay_io_log) ||
+      (path.find(".rps") == std::string::npos && path.find(".cac") == std::string::npos))
+    return;
+  static std::atomic<uint32_t> counts[3];
+  const int kind = op[0] == 'o' ? 0 : op[0] == 'r' ? 1 : 2;
+  const uint32_t n = counts[kind].fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n <= 40 || n % 200 == 0 || XFAILED(result)) {
+    REXKRNL_INFO("[replayio] {} #{} '{}' offset {:#x} length {:#x} -> {} bytes, status {:#x}", op,
+                 n, path, offset, length, done, result);
+#if REX_PLATFORM_ANDROID
+    // Host return addresses as offsets in their library, for llvm-symbolizer (the guest
+    // functions are sub_XXXXXXXX symbols of libwwe12.so).
+    if (n <= 4) {
+      struct Trace {
+        uintptr_t pcs[24];
+        int count = 0;
+      } trace;
+      _Unwind_Backtrace(
+          [](_Unwind_Context* uc, void* arg) -> _Unwind_Reason_Code {
+            auto* t = static_cast<Trace*>(arg);
+            if (t->count >= 24)
+              return _URC_END_OF_STACK;
+            t->pcs[t->count++] = _Unwind_GetIP(uc);
+            return _URC_NO_REASON;
+          },
+          &trace);
+      std::string line;
+      for (int i = 0; i < trace.count; ++i) {
+        Dl_info info{};
+        if (dladdr(reinterpret_cast<void*>(trace.pcs[i]), &info) && info.dli_fname) {
+          const char* lib = std::strrchr(info.dli_fname, '/');
+          line += fmt::format(" {}+{:#x}", lib ? lib + 1 : info.dli_fname,
+                              trace.pcs[i] - reinterpret_cast<uintptr_t>(info.dli_fbase));
+        }
+      }
+      REXKRNL_INFO("[replayio] {} #{} stack:{}", op, n, line);
+    }
+#endif
+  }
+}
