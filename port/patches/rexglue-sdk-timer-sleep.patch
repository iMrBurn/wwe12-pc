+  // Sleeps until a timer is queued or `due` (the next timer) arrives. The disruptor's spin wait
+  // alone never sleeps for long (pause loops, yields, 1 ms naps), and the kernel's 1 ms timestamp
+  // timer (KeTimeStampBundle) always has a timer due within 1 ms: ~20 % of a core, all the time
+  // (profile on 4 threads, 2026-10-20). A high-resolution waitable timer keeps the precision.
+  void SleepUntil(clock::time_point due) {
+    if (queued_.load(std::memory_order_acquire) != taken_)
+      return;
+#if defined(_WIN32)
+    if (wake_event_ && wait_timer_) {
+      if (due == clock::time_point::max()) {
+        WaitForSingleObject(wake_event_, INFINITE);
+        return;
+      }
+      const auto left = due - clock::now();
+      if (left <= clock::duration::zero())
+        return;
+      LARGE_INTEGER when;
+      when.QuadPart =
+          -std::max<int64_t>(1, std::chrono::duration_cast<std::chrono::nanoseconds>(left).count() / 100);
+      if (SetWaitableTimer(wait_timer_, &when, 0, nullptr, nullptr, FALSE)) {
+        const HANDLE handles[2] = {wake_event_, wait_timer_};
+        WaitForMultipleObjects(2, handles, FALSE, INFINITE);
+        return;
+      }
+    }
+#endif
+    std::unique_lock lock(wake_mutex_);
+    const auto queued = [&] { return queued_.load(std::memory_order_acquire) != taken_; };
+    if (due == clock::time_point::max())
+      wake_cv_.wait(lock, queued);
+    else
+      wake_cv_.wait_until(lock, due, queued);
   }
 
