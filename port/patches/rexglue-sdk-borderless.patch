   SDL_WindowFlags flags = SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY | SDL_WINDOW_HIDDEN;
+  if (REXCVAR_GET(borderless) && !IsFullscreen()) {
+    flags |= SDL_WINDOW_BORDERLESS;
+  }
