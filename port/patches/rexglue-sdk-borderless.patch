+// WWE '12 port: with fullscreen off, a window without title bar or frame ("borderless window"),
+// at the size given by window_width / window_height. Read when the window is created.
+REXCVAR_DEFINE_BOOL(borderless, false, "UI/Window",
+                    "Windowed mode without title bar or frame (used when fullscreen is off)")
+    .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
+
 namespace rex::ui {
 
 namespace {
@@ -137,6 +143,9 @@ bool WindowSDL::OpenImpl() {
   // SDL window coordinates are physical pixels on Windows and X11. Cocoa
