 bool SDLAudioDriver::Initialize() {
+  // The device can be briefly unavailable at start-up (Bluetooth headset waking up, exclusive
+  // mode held by another program): a player's game crashed that way (2026-10-20, "WASAPI can't
+  // initialize audio client"), and started fine when relaunched. A few tries, then no sound.
+  constexpr int kAttempts = 3;
+  for (int attempt = 1; attempt <= kAttempts; ++attempt) {
+    if (OpenDevice()) {
+      return true;
+    }
+    CloseDevice();
+    if (attempt < kAttempts) {
+      REXAPU_WARN("audio device not available (attempt {}/{}), retrying", attempt, kAttempts);
+      std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    }
+  }
+  REXAPU_ERROR("no audio device could be opened: the game continues without sound");
+  StartSilentClock();
+  return true;
+}
+
+void SDLAudioDriver::CloseDevice() {
+  if (sdl_stream_) {
+    SDL_DestroyAudioStream(sdl_stream_);
+    sdl_stream_ = nullptr;
+  }
+  if (sdl_initialized_) {
+    SDL_QuitSubSystem(SDL_INIT_AUDIO);
+    sdl_initialized_ = false;
+  }
+}
+
+void SDLAudioDriver::StartSilentClock() {
+  silent_running_ = true;
+  silent_thread_ = std::thread([this] {
+    using clock = std::chrono::steady_clock;
+    const auto period = std::chrono::nanoseconds(1000000000ull * channel_samples_ / frame_frequency_);
+    auto next = clock::now();
+    while (silent_running_.load(std::memory_order_relaxed)) {
+      next += period;
+      std::this_thread::sleep_until(next);
+      {
+        std::unique_lock<std::mutex> guard(frames_mutex_);
+        if (!frames_queued_.empty()) {
+          frames_unused_.push(frames_queued_.front());
+          frames_queued_.pop();
+        }
+      }
+      // As SDLCallback does for every frame it plays, silence included.
+      semaphore_->Release(1, nullptr);
+    }
+  });
+}
