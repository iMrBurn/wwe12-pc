+bool VirtualFileSystem::RegisterOverlay(const std::string_view device_mount_path,
+                                        std::unique_ptr<Device> overlay) {
+  auto global_lock = global_critical_region_.Acquire();
+  if (!overlay)
+    return false;
+  overlays_.emplace_back(std::string(device_mount_path), std::move(overlay));
+  return true;
+}
+
+Entry* VirtualFileSystem::FindOverlayFile(const std::string_view mount_path,
+                                          const std::string_view relative_path) {
+  for (const auto& [mount, overlay] : overlays_) {
+    if (!rex::string::utf8_equal_case(mount, mount_path))
+      continue;
+    // Files only: the overlay's folders (its root included) must not hide the device's.
+    auto* replaced = overlay->ResolvePath(relative_path);
+    if (replaced && !(replaced->attributes() & kFileAttributeDirectory)) {
+      REXFS_INFO("VFS: '{}{}' replaced by '{}'", mount_path, relative_path,
+                 replaced->absolute_path());
+      return replaced;
+    }
+  }
+  return nullptr;
+}
+
+Entry* VirtualFileSystem::OverlayFileFor(const std::string_view absolute_path) {
+  if (overlays_.empty())
+    return nullptr;
+  for (const auto& [mount, overlay] : overlays_) {
+    if (absolute_path.size() > mount.size() &&
+        rex::string::utf8_starts_with_case(absolute_path, mount))
+      return FindOverlayFile(mount, absolute_path.substr(mount.size()));
+  }
+  return nullptr;
+}
