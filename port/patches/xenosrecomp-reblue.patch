+static constexpr uint32_t SVR_SAMPLER_SLOTS = 32;
+static uint32_t svrTextureIndexOffset(size_t dimension, uint32_t reg)
+{
+    return reg < 16 ? uint32_t(dimension * 64 + reg * 4) : uint32_t(384 + dimension * 64 + (reg - 16) * 4);
