+    std::string VulkanDevice::describeDeviceFault() {
+        if (!deviceFaultEnabled || vk == VK_NULL_HANDLE) {
+            return "VK_EXT_device_fault not available on this driver";
+        }
+
+        auto getInfo = reinterpret_cast<PFN_vkGetDeviceFaultInfoEXT>(vkGetDeviceProcAddr(vk, "vkGetDeviceFaultInfoEXT"));
+        if (getInfo == nullptr) {
+            return "vkGetDeviceFaultInfoEXT not found";
+        }
+
+        VkDeviceFaultCountsEXT counts = {};
+        counts.sType = VK_STRUCTURE_TYPE_DEVICE_FAULT_COUNTS_EXT;
+        VkResult res = getInfo(vk, &counts, nullptr);
+        if (res != VK_SUCCESS) {
+            return "vkGetDeviceFaultInfoEXT (counts) failed: " + std::to_string(int(res));
+        }
+
+        std::vector<VkDeviceFaultAddressInfoEXT> addressInfos(counts.addressInfoCount);
+        std::vector<VkDeviceFaultVendorInfoEXT> vendorInfos(counts.vendorInfoCount);
+        VkDeviceFaultInfoEXT info = {};
+        info.sType = VK_STRUCTURE_TYPE_DEVICE_FAULT_INFO_EXT;
+        info.pAddressInfos = addressInfos.empty() ? nullptr : addressInfos.data();
+        info.pVendorInfos = vendorInfos.empty() ? nullptr : vendorInfos.data();
+        res = getInfo(vk, &counts, &info);
+        if (res != VK_SUCCESS && res != VK_INCOMPLETE) {
+            return "vkGetDeviceFaultInfoEXT failed: " + std::to_string(int(res));
+        }
+
+        char line[256];
+        std::string text = "\"" + std::string(info.description) + "\"";
+        for (const VkDeviceFaultAddressInfoEXT &a : addressInfos) {
+            snprintf(line, sizeof(line), " | address type %d at %#llx (precision %#llx)", int(a.addressType),
+                     (unsigned long long)a.reportedAddress, (unsigned long long)a.addressPrecision);
+            text += line;
+        }
+        for (const VkDeviceFaultVendorInfoEXT &v : vendorInfos) {
+            snprintf(line, sizeof(line), " | vendor \"%.64s\" code %#llx data %#llx", v.description,
+                     (unsigned long long)v.vendorFaultCode, (unsigned long long)v.vendorFaultData);
+            text += line;
+        }
+        return text;
+    }
+
     VulkanDevice::~VulkanDevice() {
         release();
