 REXCVAR_DEFINE_BOOL(replay_io_log, false, "Kernel",
                     "WWE '12 port, diagnostic: log the game's opens, reads and writes of its replay "
                     "file (cache:\\Spectacular.rps) as [replayio] lines.");
 
+// WWE '12 port, 2026-11-20 (port/patches/rexglue-sdk-z-io-log-all.patch): the start-up freeze on 2 threads
+// stops loading after its first reads; this tells which file was the last one.
+REXCVAR_DEFINE_BOOL(io_log_all, false, "Kernel",
+                    "Diagnostic: log every open / read / write of the game's files as [io] lines (the first 40 of "
+                    "each kind, then 1 in 200, and every failure); the last 128 are kept for hang_trace.txt.");
+REXCVAR_DEFINE_BOOL(xam_probe, false, "Kernel",
+                    "Diagnostic: log XNotify broadcasts / reads / listeners and XAM overlapped operations as "
+                    "[xamprobe] lines (the first 200, then a count every 5 s); also kept with the file "
+                    "operations for hang_trace.txt.");
+
+namespace {
+// The last 128 file operations and XAM events (xam_probe), for the hang dump (RexIoRecent, read by the port's crash_trace.cpp).
+struct IoRing {
+  std::mutex mutex;
+  char lines[128][224] = {};
+  uint32_t next = 0, total = 0;
+} g_io_ring;
+const auto g_io_start = std::chrono::steady_clock::now();
+}  // namespace
+
+// Copies the last file operations (oldest first, one per line) into out; returns the length written.
+extern "C"
+#if REX_PLATFORM_WIN32
+    __declspec(dllexport)
+#endif
+    int RexIoRecent(char* out, int capacity) {
+  if (!out || capacity <= 0)
+    return 0;
+  std::lock_guard lock(g_io_ring.mutex);
+  int len = 0;
+  const uint32_t count = std::min<uint32_t>(g_io_ring.total, 128);
+  for (uint32_t i = 0; i < count; ++i) {
+    const char* line = g_io_ring.lines[(g_io_ring.next + 128 - count + i) % 128];
+    const int n = snprintf(out + len, size_t(capacity - len), "%s\n", line);
+    if (n <= 0 || len + n >= capacity)
+      break;
+    len += n;
+  }
+  return len;
+}
+
+// xam_probe (2026-11-20): one XAM / XNotify event, from kernel_state.cpp, xnotifylistener.cpp and xam_notify.cpp.
+// kind: 'B' broadcast, 'G' XNotifyGetNext dequeued, 'L' listener created, 'Q' overlapped queued, 'C' completed.
+bool RexXamProbeOn() { return REXCVAR_GET(xam_probe); }
+void RexXamNote(char kind, const std::string& text) {
+  if (!REXCVAR_GET(xam_probe))
+    return;
+  const double ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - g_io_start).count();
+  auto* thread = rex::system::XThread::GetCurrentThread();
+  const uint32_t tid = thread ? thread->thread_id() : 0;
+  {
+    std::lock_guard lock(g_io_ring.mutex);
+    snprintf(g_io_ring.lines[g_io_ring.next], sizeof(g_io_ring.lines[0]), "%.1f ms thread %X (XThread%04X) xam %s", ms, tid,
+             rex::thread::current_thread_system_id(), text.c_str());
+    g_io_ring.next = (g_io_ring.next + 1) % 128;
+    ++g_io_ring.total;
+  }
+  static std::atomic<uint32_t> lines{0}, counts[5];
+  static std::atomic<int64_t> last_summary_ms{0};
+  const char* kinds = "BGLQC";
+  for (int i = 0; i < 5; ++i)
+    if (kinds[i] == kind)
+      counts[i].fetch_add(1, std::memory_order_relaxed);
+  if (lines.fetch_add(1, std::memory_order_relaxed) < 200)
+    REXKRNL_INFO("[xamprobe] {:.1f} ms thread {:X} (XThread{:04X}) {}", ms, tid,
+                 rex::thread::current_thread_system_id(), text);
+  int64_t last = last_summary_ms.load(std::memory_order_relaxed);
+  if (int64_t(ms) - last >= 5000 && last_summary_ms.compare_exchange_strong(last, int64_t(ms)))
+    REXKRNL_INFO("[xamprobe] 5 s: broadcasts {}, notifications read {}, listeners {}, overlapped queued {}, "
+                 "completed {}",
+                 counts[0].exchange(0), counts[1].exchange(0), counts[2].exchange(0), counts[3].exchange(0),
+                 counts[4].exchange(0));
+}
+
 namespace rex::kernel::xboxkrnl {
 using namespace rex::system;
 
+static void NoteIoAll(const char* op, const std::string& path, uint64_t offset, uint32_t length,
+                      uint32_t done, X_STATUS result) {
+  if (!REXCVAR_GET(io_log_all))
+    return;
+  const double ms =
+      std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - g_io_start).count();
+  auto* thread = XThread::GetCurrentThread();
+  const uint32_t tid = thread ? thread->thread_id() : 0;
+  {
+    std::lock_guard lock(g_io_ring.mutex);
+    snprintf(g_io_ring.lines[g_io_ring.next], sizeof(g_io_ring.lines[0]),
+             "%.1f ms thread %X (XThread%04X) %s '%s' offset %#llx length %#x -> %u, status %#x", ms, tid,
+             rex::thread::current_thread_system_id(), op, path.c_str(),
+             static_cast<unsigned long long>(offset), length, done, static_cast<uint32_t>(result));
+    g_io_ring.next = (g_io_ring.next + 1) % 128;
+    ++g_io_ring.total;
+  }
+  static std::atomic<uint32_t> counts[3];
+  const int kind = op[0] == 'o' ? 0 : op[0] == 'r' ? 1 : 2;
+  const uint32_t n = counts[kind].fetch_add(1, std::memory_order_relaxed) + 1;
+  if (n <= 40 || n % 200 == 0 || XFAILED(result))
+    REXKRNL_INFO("[io] {:.1f} ms thread {:X} {} #{} '{}' offset {:#x} length {:#x} -> {} bytes, status {:#x}", ms,
+                 tid, op, n, path, offset, length, done, result);
+}
+
 // replay_io_log: the first 40 calls of each kind, then one in 200, and every failure.
 static void NoteReplayIo(const char* op, const std::string& path, uint64_t offset, uint32_t length,
                          uint32_t done, X_STATUS result) {
+  NoteIoAll(op, path, offset, length, done, result);
   if (!REXCVAR_GET(replay_io_log) ||
       (path.find(".rps") == std::string::npos && path.find(".cac") == std::string::npos))
     return;
