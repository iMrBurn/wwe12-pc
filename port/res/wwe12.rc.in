// Icône et informations de fichier de wwe12.exe (généré par CMake depuis wwe12.rc.in).
#include <winver.h>

1 ICON "@WWE12_RES_DIR@/wwe12.ico"

// PlayStation button icons (tools/extract_ps3_buttons.py, native/wwe12_buttons.cpp).
101 RCDATA "@WWE12_RES_DIR@/ps3_buttons.bin"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @WWE12_VERSION_MAJOR@,@WWE12_VERSION_MINOR@,@WWE12_VERSION_PATCH@,0
PRODUCTVERSION @WWE12_VERSION_MAJOR@,@WWE12_VERSION_MINOR@,@WWE12_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "WWE '12 PC"
      VALUE "ProductName", "WWE '12 PC (unofficial native port)"
      VALUE "FileVersion", "@WWE12_VERSION@"
      VALUE "ProductVersion", "@WWE12_VERSION@"
      VALUE "InternalName", "wwe12"
      VALUE "OriginalFilename", "wwe12.exe"
      VALUE "Comments", "Fan project, not affiliated with WWE, THQ or Yuke's. GPL-3.0."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
